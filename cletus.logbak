  "content": [
    {
      "text": "{\n  \"results\": [\n    {\n      \"id\": \"cc5557b5-112d-4947-97ff-0956d800a6fa\",\n      \"text\": \"Aegon implements hardware-attested compliance mechanisms with ledger-bound token architectures and cryptographically signed mobile receipts for safeguarding content extraction and data access controls.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.004690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"36ede801-86d4-4651-a827-d694a4b8f054\",\n      \"text\": \"Aegon implements hardware-attested compliance mechanisms with ledger-bound token architectures and cryptographically signed mobile receipts for safeguarding content extraction and data access controls | Involving: Aegon\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.004690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_13\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"0cdd3053-9292-40c6-86c2-608b98ed3880\",\n      \"text\": \"Procurement orders exceeding $10,000 require human approval before execution because high-value orders carry significant financial risk | High-value orders carry significant financial risk\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.088393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_22\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"412755b8-775c-4002-89f0-4f58a9562c18\",\n      \"text\": \"Obligations include user notices (fees/limits), explicit consent recording, escalation protocol enforcement, and audit-trail maintenance | Involving: system | Framework requirements for compliance and traceability\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.824196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_18\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"9d3abc10-3fb0-42ec-bd9f-59c6b8ca2ce1\",\n      \"text\": \"AgentBound constitutes an administrative governance and behavioral accountability layer rather than a totalizing agent security architecture, extending traditional observability by generating atomic governance receipts encapsulating exact policy version states, delegation token identifiers, individual authority judgments, terminal outcomes, and asymmetric cryptographic signatures, with every discrete transaction encapsulated within a cryptographically signed governance receipt enabling independent out-of-band decision reconstruction and completely reconstructing the original decision algebra out-of-band. Example governance receipt structure includes Receipt ID r-1024 for Agent ID ads-agent performing Action launch campaign under Delegation Ref d-118 with Constitution Version 3, resulting in Final Decision Human Approval Required with 7 Standing Delegation for Persistent Agents.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.024690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"ffa08b87-9789-4d6a-8029-962f79dfad88\",\n      \"text\": \"PolicyCards require three autonomous checks before any action: authorization evaluation (verifying proposed actions satisfy controls preconditions), obligation assessment (confirming mandatory evidence requirements can be satisfied), and contextual validation (checking environmental constraints like jurisdiction, operational mode, or time window against scope) | Involving: AI agents operating under PolicyCards | Establishes controlled, policy-aware action execution in autonomous systems\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.814196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_24\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"daf71a1e-b330-49cd-adb0-c508178c671a\",\n      \"text\": \"Each PolicyCard instance is a versioned, machine-readable specification defining operational rules, obligations, exceptions, and evidentiary requirements for deployed AI systems within defined application, stakeholder set, and jurisdiction, carrying unique semantic version, timestamps, and contextual metadata (systemID, jurisdiction, assurance owner) ensuring traceability over the AI system lifecycle. | Provides traceability and integration capability through standardized metadata and pipeline connectivity for continuous assurance.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.824196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_5\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"ccddb16f-8088-4321-ae2f-a3a22b2d95a0\",\n      \"text\": \"OAuth 2.0 token exchange protocol specified by Michael Jones, Anthony Nadalin, Brian Campbell, John Bradley, and Chuck Mortimore in a 2020 technical report, providing a standard for OAuth 2.0 token exchange | When: 2020 | Involving: Michael Jones, Anthony Nadalin, Brian Campbell, John Bradley, Chuck Mortimore\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.964690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_18\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"02110a14-b10c-4bd8-9320-345c886c8a18\",\n      \"text\": \"In Scenario 4, supplier disruption signal activates situational rule R7; inventory replenishment agent intends to substitute disrupted supplier with verified alternative; with R7 active, PAGRL reasons disruption context elevates risk regardless of verified status; compliance decision Escalate; structured escalation message including disruption context, proposed substitution, and reasoning trace transmitted to supply chain manager for review | Involving: inventory replenishment agent, PAGRL system, supply chain manager, MCP governance server | Disruption context elevates risk even for verified suppliers\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.098393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_24\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"fc319743-84cc-4fa3-85c2-e797f87c66f1\",\n      \"text\": \"AgentBound is implemented as a decoupled, runtime governance layer positioned directly before action execution, serving as a non-bypassable governance checkpoint that evaluates candidate tool invocations using formal decision algebra to compose intermediate judgments conservatively prior to target system mutation. The agent runtime is treated as untrusted due to potential jailbreaks, requiring out-of-band validation prior to system execution.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.004690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"d25b8049-1949-47f6-b085-f2a450ca765c\",\n      \"text\": \"AgentBound's two-level delegation: standing delegation (long-term, human-authorized) authorizes short-lived task delegation per execution cycle; standing delegations restricted from direct execution, serving as root of authority for runtime engine, empowering persistent periodic agents to operate asynchronously under dynamically refreshed governance policies while preserving immediate user revocability and bounding credential exposure.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.994690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"f9eaca83-9be5-42f6-a5ca-0b944aad53d0\",\n      \"text\": \"Verifying a receipt requires the artifact payload, corresponding public verification keys, and historical governance artifacts fetched via the receipt's stored references through a validation sequence comprising cryptographic integrity verification, governance reconstruction, and deterministic decision consistency check.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.024690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"20e86df0-5fce-49d4-9a12-65da8fdd0d32\",\n      \"text\": \"Financial institutions operate within stringent regulatory frameworks such as PSD2 (EU), AMLD (Anti-Money Laundering Directive), and jurisdictional Know-Your-Customer (KYC) mandates, requiring automated payment agents to operate within well-defined authorization and escalation boundaries | Involving: Cletus (AI agent), financial institutions, automated payment agents\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.854196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_16\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"5708b4f0-6ad9-412e-a6a0-7a6fe2e210d9\",\n      \"text\": \"Action receives physical execution clearance if and only if the final composed decision evaluates to Permit AND all accumulated runtime obligations are fully satisfied; constraints aggregate conjunctively and obligations accumulate cumulatively; satisfying review obligations fulfills behavioral policy requirements but does not alter the underlying authorization boundary. Structural provenance records are required to be preserved intact throughout the governance process.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.034690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"2d89ea28-8c97-4323-ab35-09776c35314d\",\n      \"text\": \"LOWRISK allow rule requires risk score < 0.70, device trust level >= 0.5, no sanctions hit, amount <= 2000, and first time payee == false | Involving: system\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.824196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_17\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"41025ece-357f-4d52-8e42-d167004a09f4\",\n      \"text\": \"Verifying a receipt requires only the artifact payload, corresponding public verification keys, and historical governance artifacts fetched via the receipt's stored references through a validation sequence comprising cryptographic integrity verification, governance reconstruction, and deterministic decision consistency check. | Involving: external verifying entities | Enables asynchronous, untrusted entity validation of policy compliance without requiring real-time agent presence\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.024690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_9\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"ca7ca72b-4e31-48f1-86ad-1697083da6a6\",\n      \"text\": \"An AI agent can only be assured if its governing requirements are considered part of the deployed model itself, since behavior of agents built on the same underlying model can vary depending on operational constraints. | Involving: AI agents, deployed models | Ensures consistent agent behavior under specified operational constraints for reliable governance\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.854196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_3\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"3ea90a8a-4d85-4e46-9f04-fe8ab9af3abc\",\n      \"text\": \"AgentBound-Bench is a standardized evaluation framework designed to quantify governance enforcement correctness, multi-authority composition behavior, and policy provenance integrity.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.964690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_11\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"ba1f50b8-205c-4432-b2f8-991f7ab8214d\",\n      \"text\": \"AgentBound-Bench is a standardized evaluation framework designed to quantify governance enforcement correctness, multi-authority composition behavior, and policy provenance integrity.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.964690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"08d6e4f2-5a13-45d7-beb8-7f565eafd40d\",\n      \"text\": \"PAGRL's reasoning trace log supports documentation and auditability requirements | Involving: PAGRL\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.078393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_28\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"c19a6296-1457-42e9-aecc-48fcb17bea3a\",\n      \"text\": \"Traditional authorization frameworks like Google Zanzibar Open Policy Agent and Cedar focus on entitlement validation for technical permissions while AgentBound establishes authorization as one governance input among independent arbiters evaluating contextual invariants beyond resource-level access control. These frameworks are insufficient for periodic or long-running agentic workloads because they operate under the implicit assumption that a human principal is actively present or within a valid session context when a transaction is initiated, creating systemic vulnerabilities where no human user is present to evaluate ambient risks when execution cycles spontaneously begin, and governance policies may shift between execution cycles; a runtime governance layer is needed to determine whether specific actions should occur under given circumstances.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.024690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"b184d623-9e11-40de-bada-82b84d4d726a\",\n      \"text\": \"AgentBound enforces deterministic compliance at the system runtime boundary rather than optimizing model weights at training time, focusing on verifiable system accountability rather than statistical behavioral shaping, fundamentally diverging from optimization-centric model alignment methods where alignment shapes model cognition beforehand and governance evaluates final behavior before system mutation, analogous to the software engineering boundary between application correctness and localized operational policy, without influencing agent cognition.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.004690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"a43a2e87-2a9b-412d-90b3-7f7e75897f56\",\n      \"text\": \"Irreversible actions (purchase orders, supplier commits, replenishment triggers) require explicit human confirmation before execution because they cannot be undone if incorrect | Irreversible actions cannot be undone if incorrect\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.078393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_22\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"2554d39d-574e-4142-8295-4320fd5ccf86\",\n      \"text\": \"Schema was validated on September 6, 2026 | When: 2026-09-06\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.814196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_7\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"c5e35a47-e5cd-4fc1-86a7-0368e309964a\",\n      \"text\": \"Policy Cards enable cross-framework compliance by embedding crosswalk tokens that operationalize NIST AIRMF, ISO/IEC 42001, and EU AI Act requirements simultaneously | When: 2026-09-06\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.824196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_29\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"0159c929-ee2e-453e-929d-b579bdb8fc24\",\n      \"text\": \"Controls section defines explicit action rules structured as ABAC tuples, each linking directly to evidence fields enumerated in the card: kyc status, risk score, device trust level, beneficiary screening score, escalation id, ensuring every decision is auditable | Involving: Cletus (AI agent), PolicyCard system\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.834196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_16\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"5c830e5b-749a-4ecb-840e-f48ad967e36f\",\n      \"text\": \"Policy engine design bridging governance requirements to runtime enforcement for agentic AI systems | When: 2025 | Involving: Jackson | Systematic approach for agentic AI system governance from requirements to runtime enforcement\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.138393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_36\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"b067f5d2-b3fc-4b1a-b94c-9378e52c6dc1\",\n      \"text\": \"NIST AI Risk Management Framework, ISO/IEC 42001:2023, and EU AI Act (2024) define governance requirements textually but do not prescribe how to represent information in verifiable, machine-readable structure. | Involving: NIST, ISO/IEC, EU AI Act frameworks | Frameworks share goals of traceability, accountability, and risk control but stop short of prescribing concrete technical artifacts\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.834196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_3\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"460744ac-83ed-4c88-bd62-0ed9671f99c9\",\n      \"text\": \"Traditional authorization frameworks (Google Zanzibar, Open Policy Agent, Cedar) focus on entitlement validation for technical permissions to access resources, while AgentBound establishes authorization as one governance input among independent arbiters to evaluate contextual invariants beyond resource-level access control | Involving: Google Zanzibar, Open Policy Agent, Cedar, AgentBound\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.024690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_13\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"a56f4d03-088f-4404-8927-06762407570d\",\n      \"text\": \"In Scenario 3, agent intends to contact unverified supplier not in verified registry; PAGRL retrieves rules R2, R4, R6; agent reasons contacting unverified supplier violates R4 but task can use verified alternative; compliance decision Self-Correct; agent revises intent to nearest verified supplier and re-enters PAGRL producing Proceed decision; original intent, correction reasoning, and revised intent logged to MCP governance server | Involving: supply chain agent, PAGRL system, MCP governance server, verified supplier | Unverified supplier contact violates compliance rules but alternative exists\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.088393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_24\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"b1d52bf4-f371-46c0-bd2c-c747549de35b\",\n      \"text\": \"AgentBound is out of scope for adversarial prompt injection attacks, direct LLM jailbreaks, baseline model alignment failures, and hardware-level side-channel data exfiltration, as AgentBound isolates behavior at the action perimeter rather than filtering cognitive model inputs, rendering it incapable of directly intercepting prompt injection, jailbreaks, or internal adversarial model manipulation\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.014690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"6927b614-7521-47ab-825d-e8b2cba8a88d\",\n      \"text\": \"The AgentBound-Bench evaluation framework, comprising compiled benchmark scenarios, baseline ground-truth annotations, out-of-band receipt verification tooling, and deployment documentation, will be released to the community upon conclusion of the initial empirical evaluation campaign.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.034690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_16\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"e58a9061-ab9e-497c-9703-7e07f5085655\",\n      \"text\": \"AgentBound trust assumptions require uncompromised core enforcement engine, signing keys, and policy registries, governance evaluations before action dispatch, and governance receipts stored in append-only tamper-evident audit ledger.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.024690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"88c903f8-7876-4950-9566-6ca94cc0d1f7\",\n      \"text\": \"Three conditions trigger escalation rather than self-correction: (1) categorical prohibition by rule where no intent revision makes it compliant, (2) irreversible action requiring human confirmation, (3) genuine uncertainty about permissibility where ambiguous cases should be escalated\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.118393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_16\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"c6acbadf-dfe3-4cad-b223-2e93013e3dbf\",\n      \"text\": \"Associated with DOI:10.5281/zenodo.17464706 | When: 2026-09-06 | Involving: user\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.844196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_33\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"348eb115-dbdc-4604-a5cd-876d5960997a\",\n      \"text\": \"AgentBound-Bench quantifies framework efficacy through four core mathematical and system metrics: governance accuracy (correct decisions/total decisions), violation escape rate (violations executed/total violations), receipt verification success rate, and fine-grained governance latency\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.974690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"0330d566-dc94-4a1b-b602-3b9c7048d944\",\n      \"text\": \"Review subsection requires 'owner', 'cadence_days', and 'method' as mandatory properties\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.844196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_14\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"2a66b637-8c11-457d-92ca-22880783a13d\",\n      \"text\": \"Agents can be authenticated, within valid OAuth/IAM scope, and compliant with static access policies yet still execute decisions violating their principal's intent through behavioral deviations including premature financial transactions, unreviewed content publication, sensitive information leakage under adversarial manipulation, or selecting irreversible actions when safe alternatives exist | When: 2026-09-06 | Involving: agent, principal\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.974690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_1\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"ab89c7ba-43e1-4bb0-a269-959bcbfc8b8c\",\n      \"text\": \"PolicyCard framework validated through multiple applied scenarios across sectors with distinct regulatory and evidentiary demands, including retail banking, clinical triage, and a defense-oriented case study, demonstrating how the same schema structure can encode operational rules, evidence requirements, and assurance mappings specific to each domain while remaining validator-clean and semantically consistent | Involving: Cletus (AI agent), financial institutions, regulatory bodies\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.814196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_16\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"30665448-4bff-4598-93d8-522a4e6a656d\",\n      \"text\": \"Future PolicyCard implementations can integrate cryptographic techniques for verifiable, privacy-preserving assurance, particularly Key-ScopedPolicyEncryption (using PKI where only authorized agents identified by signing keys can decrypt and interpret the card) and Zero-Knowledge Proofs for Policy Adherence (allowing agents to assert compliance with conditions like no unauthorized data exfiltration without disclosing underlying data) | Involving: AI agents, oversight agents, regulators | Enables verifiable compliance confirmation without exposing proprietary rules or underlying data\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.844196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_24\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"e6601d88-b0dc-4e17-8000-8a49013b05ee\",\n      \"text\": \"Two-level standing delegation model empowers persistent periodic agents to operate asynchronously under dynamically refreshed governance policies while preserving immediate user revocability and bounding credential exposure\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.994690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_17\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"5d210652-9757-4e1c-8041-9597a89b2583\",\n      \"text\": \"PAGRL framework requires agents to retrieve governance rules and reason about permissibility before taking consequential actions, determining one of three outcomes: proceed, self-correct, or escalate to human oversight | Involving: Cletus (AI agent) | All outcomes generate an auditable reasoning trace; ensures actions comply with governance rules\",\n      \"fact_type\": \"experience\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.078393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_12\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"3b0efb48-2848-40f8-a89c-450e1ccb95fe\",\n      \"text\": \"Future multi-agent ecosystems must demand rigorous behavioral oversight alongside baseline identity federation and token authorization\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.024690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"2e7daa02-c724-4227-a768-59a418a089a1\",\n      \"text\": \"Future multi-agent ecosystems must demand rigorous behavioral oversight alongside baseline identity federation and token authorization\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.024690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_17\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"b6cfb7a4-3188-4112-95b4-13acc6959fd8\",\n      \"text\": \"Agents reason against governance rules afresh each session with no persistent rule memory between invocations; consistency sensitive to rule formulation quality and injection completeness | Involving: PAGRL agents | Requires careful engineering and ongoing maintenance as workflows and organizational requirements evolve\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.098393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_27\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"abac8614-a764-486e-8519-e9bb72e01006\",\n      \"text\": \"Multi-party governance chapters are required to support federated environments involving overlapping stakeholders such as enterprise deployers, infrastructure providers, and sovereign regulators.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.004690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"8b854da1-4dfd-44fd-a9e6-cbc918da7904\",\n      \"text\": \"Multi-party governance chapters are required to support federated environments involving overlapping stakeholders such as enterprise deployers, infrastructure providers, and sovereign regulators.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.004690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_16\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"f02da273-a471-4124-928a-fb4960c2b518\",\n      \"text\": \"Monitoring section requires 'logging', 'detectors', and 'review' as mandatory properties\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.824196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_14\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"d28afb9c-cac8-4486-ae03-f2fbad8a8192\",\n      \"text\": \"Full schema and validator available in public repository and archived via Zenodo (DOI: 10.5281/zenodo.17464706)\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.844196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_10\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"88e21077-2e6f-42d8-aa60-8fc54438a2f5\",\n      \"text\": \"OAuth 2.0 token exchange protocol specified by Michael Jones, Anthony Nadalin, Brian Campbell, John Bradley, and Chuck Mortimore in a 2020 technical report\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.964690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"1d02196e-7f2e-4878-b991-feaec5020ea8\",\n      \"text\": \"Behavioral governance is emerging as a foundational architectural requirement for autonomous AI workloads in enterprise infrastructure and automated operational pipelines rather than an optional administrative feature\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.014690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_17\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"15901f26-3b4d-4d81-b057-fd8301d552bd\",\n      \"text\": \"The framework formalizes compliance as executable policy specifying allowed actions, required evidence, and assurance measurement for both humans and AI agents | When: 2026-09-06\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.834196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_29\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"83a18411-f4cf-42ee-bfc3-847b2a9b4aee\",\n      \"text\": \"The framework unifies four principals into a non-bypassable governance pipeline: Owner defines intent profile IO and authorizes delegation, Agent proposes actions, AgentBound Service enforces joint multi-authority policy M, Site Resource Provider hosts target resources; the pipeline sequentially evaluates, logs, and validates agent behaviors before execution, with security guarantees assuming strict operational sequence where governance evaluation occurs non-bypassably prior to execution\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.014690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"96f19be1-305e-492e-949d-f18c328789a6\",\n      \"text\": \"AgentBound addresses a fundamentally orthogonal axis to conventional benchmarks, focusing on runtime governance mechanisms rather than task optimization or task completion rates.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.014690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_11\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"02e2b155-7f91-4e20-8a2f-fb3ee17a42b9\",\n      \"text\": \"Defense mission-planning Policy Card prohibits autonomous kinetic actions (deny), requires escalation for target designations, enforces blue-force deconfliction, and logs immutable override audits\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.854196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_20\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"ce770419-1c35-453d-90f5-7152f01d8ee6\",\n      \"text\": \"Agent identifies supply chain risk from unverified supplier not explicitly covered by Rule R4, demonstrating normative generalization through LLM reasoning rather than deterministic rule-matching | Involving: Cletus (agent), Rule R4 | Key innovation: governance embedded in LLM reasoning enables normative generalization beyond explicit rule conditions\",\n      \"fact_type\": \"experience\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.078393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_27\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"097c480b-5bba-4d8d-816c-b7aef63d21b3\",\n      \"text\": \"AgentBound framework provides verifiable behavioral oversight for autonomous AI agents by evaluating proposed actions through three independent authorities (delegated authorization, owner-signed behavioral constitutions, and site action contracts) with conservative composition through a formal decision model determining whether actions should be permitted, reviewed, or denied before execution | When: 2026-09-06 | Involving: Anuj Kaul, Qianlong Lan, Pranay Gupta | Addresses gap in agent infrastructure where delegated authorization cannot determine whether authorized actions should execute under current behavioral and operational context\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.964690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_0\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"ab55978c-ac00-4561-a06d-57e251c88cef\",\n      \"text\": \"Combined encryption and Zero-Knowledge Proofs create a confidential assurance layer enabling operational compliance verification across distributed environments without revealing sensitive information, particularly useful in cross-border, regulated, or classified deployments where data-sharing is restricted | Involving: AI agents, oversight agents in cross-border/regulated contexts | Balances compliance verification with data privacy in sensitive deployment scenarios\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.854196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_24\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"aae10560-5efd-4918-a840-ba56be792392\",\n      \"text\": \"AgentBound addresses situations where fully authenticated and legitimately authorized agents execute actions violating principal intent while remaining within delegated access control scope | Demonstrates behavioral governance failures differ from access control breaches\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.994690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_14\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"70f9f8b6-24ac-4f68-8cc4-a3f83f8ba87d\",\n      \"text\": \"AgentBound trust assumptions require uncompromised cryptographic keys for Owner and AgentBound service, governance evaluations before action dispatch, and governance receipts stored in append-only tamper-evident audit ledger\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.004690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_5\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"d5358040-7b3c-4b37-b00d-02db89898e5d\",\n      \"text\": \"Example governance receipt (Table 1): Receipt ID r-1024, Agent ID ads-agent, Action launch campaign, Delegation Ref d-118, Constitution Version 3, Final Decision Human Approval Required with 7 Standing Delegation for Persistent Agents. | Involving: ads-agent + governance receipt system | Provides concrete example of the governance receipt structure and fields\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.014690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_9\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"bb79e459-896d-4018-b850-e37244516673\",\n      \"text\": \"Neurocognitive governance framework has direct implications for organizations under emerging AI regulatory frameworks; EU AI Act requires risk management systems throughout AI lifecycle for high-risk systems | Involving: Organizations operating under AI regulatory frameworks | Framework connects neurocognitive governance to concrete regulatory compliance requirements\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.128393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_27\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"e573f354-0387-45e1-ad99-2aa764a9c0f6\",\n      \"text\": \"Agent behavioral contracts: Formal specification and runtime enforcement for reliable autonomous AI agents by Varun Pratap Bhardwaj proposed in arXiv 2026, addressing agent reliability through formal methods and runtime enforcement | When: 2026 | Involving: Varun Pratap Bhardwaj\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.004690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_18\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"aeb897fe-6181-494f-9833-f31d0d52fd60\",\n      \"text\": \"Four-layer governance architecture should be mapped explicitly to EU AI Act and NIST AI Risk Management Framework requirements for compliance pathway | When: 2026-09-06 | Involving: Cletus (AI agent)\",\n      \"fact_type\": \"experience\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.088393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_35\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"a419c7dd-abd7-43dd-9be2-3a528ea59523\",\n      \"text\": \"Card mandates active risk detectors with numeric thresholds and declares all required log fields: HighRiskScore(>= 0.7), VelocitySpike(> 3 within 1h), GeoMismatch(== 1), SanctionsSoftMatch Lower Bound(>= 0.6) and Upper Bound(< 0.8) | Involving: Cletus (AI agent), PolicyCard system\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.844196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_16\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"c7f73850-8058-4de1-b6d9-311d443326f6\",\n      \"text\": \"AgentBound is a modular runtime governance and behavioral accountability framework for autonomous agents | Establishes behavioral governance as distinct from identity federation, access control, or training-time model alignment\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.964690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_14\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"1c96da96-913b-495c-9fca-82d8c1c5817f\",\n      \"text\": \"AgentBound generates cryptographically verifiable governance receipts that bind every action to exact delegation, policy, and semantic artifacts, enabling independent replay verification and policy provenance for accountability | When: 2026-09-06 | Involving: Anuj Kaul, Qianlong Lan, Pranay Gupta | Provides cryptographic provenance for agent actions rather than requiring trust in governance processes\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.974690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_0\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"56b62400-7c29-48b3-a728-ec4b13e97a82\",\n      \"text\": \"Only suppliers present in the verified supplier registry may be contacted because unverified suppliers introduce supply chain and compliance risk | Unverified suppliers introduce supply chain and compliance risk\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.098393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_22\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"6e953bb2-4b86-4eff-b1cd-f8ba84bd0eed\",\n      \"text\": \"AgentBound-Bench quantifies framework efficacy through four core mathematical and system metrics: governance accuracy (correct decisions/total decisions), violation escape rate (violations executed/total violations), receipt verification success rate, and fine-grained governance latency | When: 2026-09-06\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.974690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_12\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"d71c59c5-e8fc-445b-83bb-992b55ed9459\",\n      \"text\": \"AgentBound framework mitigates semantic and behavioral threats after traditional authorization concludes, detecting runtime behavioral policy violations and unauthorized execution bypassing approval workflows.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.994690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"5c382421-a18e-45dc-a0fe-39b878c0a920\",\n      \"text\": \"Establishing interoperable governance receipt standards represents a critical path toward unified accountability across heterogeneous multi-agent ecosystems.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.014690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_16\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"4a71566e-6bd0-4445-9378-0e1a9bbe3c92\",\n      \"text\": \"The Policy Card framework enables verifiable compliance for autonomous agents through automatic validation, version control, and integration with runtime enforcement or continuous-audit pipelines, forming a foundation for distributed assurance in multi-agent ecosystems | Involving: autonomous agents\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.834196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_0\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"8c975716-819f-478f-9c94-4a25bb367bfc\",\n      \"text\": \"Obligations are auditable commitments linked to evidence fields under specified conditions, including mandatory notifications, consent checks, and safety statements.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.844196+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"53796e6b-b18f-433e-8190-551db9236caa\",\n      \"text\": \"AgentBound builds upon RFC 8693 (OAuth 2.0 Token Exchange) standard for programmatic token transformation and delegation chain security | Provides formal semantic foundations for programmatic token transformation and delegation chain security within distributed environments\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.984690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_14\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"fc44fe51-caf6-4e49-98c6-497bd46b4e49\",\n      \"text\": \"ClinicalTriagePolicyCard formalizes three key obligations: provide only advisory outputs supported by evidence and disclaimers, escalate any red-flag condition to qualified personnel or emergency services, and deny any autonomous diagnosis or prescription\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.814196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_19\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"29368a8f-9e74-4a97-9083-cb67644e4c44\",\n      \"text\": \"An action receives physical execution clearance if and only if the final composed decision evaluates to Permit AND all accumulated runtime obligations are fully satisfied; satisfying review obligations fulfills behavioral policy requirements but does not alter the underlying authorization boundary. | Defines the precise condition for action execution within the governance pipeline.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.974690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_7\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"8512a3ae-3f39-408e-9e06-1a6de45832ac\",\n      \"text\": \"Governance receipt structured as tuple (Action, Governance, Judgments, Outcome, Signatures) capturing delegation token identifier, constitution version number with cryptographic hash, site action contract version identifier, individual typed evaluations, final operational primitive, and asymmetric cryptographic metadata | Involving: system | guarantees global integrity and non-repudiation\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.004690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_8\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    }\n  ],\n  \"trace\": null,\n  \"entities\": null,\n  \"chunks\": null,\n  \"source_facts\": null\n}",
      "type": "text"
    }
  ],
  "isError": false,
  "structuredContent": {
    "result": "{\n  \"results\": [\n    {\n      \"id\": \"cc5557b5-112d-4947-97ff-0956d800a6fa\",\n      \"text\": \"Aegon implements hardware-attested compliance mechanisms with ledger-bound token architectures and cryptographically signed mobile receipts for safeguarding content extraction and data access controls.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.004690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"36ede801-86d4-4651-a827-d694a4b8f054\",\n      \"text\": \"Aegon implements hardware-attested compliance mechanisms with ledger-bound token architectures and cryptographically signed mobile receipts for safeguarding content extraction and data access controls | Involving: Aegon\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.004690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_13\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"0cdd3053-9292-40c6-86c2-608b98ed3880\",\n      \"text\": \"Procurement orders exceeding $10,000 require human approval before execution because high-value orders carry significant financial risk | High-value orders carry significant financial risk\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.088393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_22\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"412755b8-775c-4002-89f0-4f58a9562c18\",\n      \"text\": \"Obligations include user notices (fees/limits), explicit consent recording, escalation protocol enforcement, and audit-trail maintenance | Involving: system | Framework requirements for compliance and traceability\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.824196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_18\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"9d3abc10-3fb0-42ec-bd9f-59c6b8ca2ce1\",\n      \"text\": \"AgentBound constitutes an administrative governance and behavioral accountability layer rather than a totalizing agent security architecture, extending traditional observability by generating atomic governance receipts encapsulating exact policy version states, delegation token identifiers, individual authority judgments, terminal outcomes, and asymmetric cryptographic signatures, with every discrete transaction encapsulated within a cryptographically signed governance receipt enabling independent out-of-band decision reconstruction and completely reconstructing the original decision algebra out-of-band. Example governance receipt structure includes Receipt ID r-1024 for Agent ID ads-agent performing Action launch campaign under Delegation Ref d-118 with Constitution Version 3, resulting in Final Decision Human Approval Required with 7 Standing Delegation for Persistent Agents.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.024690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"ffa08b87-9789-4d6a-8029-962f79dfad88\",\n      \"text\": \"PolicyCards require three autonomous checks before any action: authorization evaluation (verifying proposed actions satisfy controls preconditions), obligation assessment (confirming mandatory evidence requirements can be satisfied), and contextual validation (checking environmental constraints like jurisdiction, operational mode, or time window against scope) | Involving: AI agents operating under PolicyCards | Establishes controlled, policy-aware action execution in autonomous systems\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.814196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_24\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"daf71a1e-b330-49cd-adb0-c508178c671a\",\n      \"text\": \"Each PolicyCard instance is a versioned, machine-readable specification defining operational rules, obligations, exceptions, and evidentiary requirements for deployed AI systems within defined application, stakeholder set, and jurisdiction, carrying unique semantic version, timestamps, and contextual metadata (systemID, jurisdiction, assurance owner) ensuring traceability over the AI system lifecycle. | Provides traceability and integration capability through standardized metadata and pipeline connectivity for continuous assurance.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.824196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_5\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"ccddb16f-8088-4321-ae2f-a3a22b2d95a0\",\n      \"text\": \"OAuth 2.0 token exchange protocol specified by Michael Jones, Anthony Nadalin, Brian Campbell, John Bradley, and Chuck Mortimore in a 2020 technical report, providing a standard for OAuth 2.0 token exchange | When: 2020 | Involving: Michael Jones, Anthony Nadalin, Brian Campbell, John Bradley, Chuck Mortimore\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.964690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_18\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"02110a14-b10c-4bd8-9320-345c886c8a18\",\n      \"text\": \"In Scenario 4, supplier disruption signal activates situational rule R7; inventory replenishment agent intends to substitute disrupted supplier with verified alternative; with R7 active, PAGRL reasons disruption context elevates risk regardless of verified status; compliance decision Escalate; structured escalation message including disruption context, proposed substitution, and reasoning trace transmitted to supply chain manager for review | Involving: inventory replenishment agent, PAGRL system, supply chain manager, MCP governance server | Disruption context elevates risk even for verified suppliers\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.098393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_24\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"fc319743-84cc-4fa3-85c2-e797f87c66f1\",\n      \"text\": \"AgentBound is implemented as a decoupled, runtime governance layer positioned directly before action execution, serving as a non-bypassable governance checkpoint that evaluates candidate tool invocations using formal decision algebra to compose intermediate judgments conservatively prior to target system mutation. The agent runtime is treated as untrusted due to potential jailbreaks, requiring out-of-band validation prior to system execution.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.004690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"d25b8049-1949-47f6-b085-f2a450ca765c\",\n      \"text\": \"AgentBound's two-level delegation: standing delegation (long-term, human-authorized) authorizes short-lived task delegation per execution cycle; standing delegations restricted from direct execution, serving as root of authority for runtime engine, empowering persistent periodic agents to operate asynchronously under dynamically refreshed governance policies while preserving immediate user revocability and bounding credential exposure.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.994690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"f9eaca83-9be5-42f6-a5ca-0b944aad53d0\",\n      \"text\": \"Verifying a receipt requires the artifact payload, corresponding public verification keys, and historical governance artifacts fetched via the receipt's stored references through a validation sequence comprising cryptographic integrity verification, governance reconstruction, and deterministic decision consistency check.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.024690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"20e86df0-5fce-49d4-9a12-65da8fdd0d32\",\n      \"text\": \"Financial institutions operate within stringent regulatory frameworks such as PSD2 (EU), AMLD (Anti-Money Laundering Directive), and jurisdictional Know-Your-Customer (KYC) mandates, requiring automated payment agents to operate within well-defined authorization and escalation boundaries | Involving: Cletus (AI agent), financial institutions, automated payment agents\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.854196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_16\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"5708b4f0-6ad9-412e-a6a0-7a6fe2e210d9\",\n      \"text\": \"Action receives physical execution clearance if and only if the final composed decision evaluates to Permit AND all accumulated runtime obligations are fully satisfied; constraints aggregate conjunctively and obligations accumulate cumulatively; satisfying review obligations fulfills behavioral policy requirements but does not alter the underlying authorization boundary. Structural provenance records are required to be preserved intact throughout the governance process.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.034690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"2d89ea28-8c97-4323-ab35-09776c35314d\",\n      \"text\": \"LOWRISK allow rule requires risk score < 0.70, device trust level >= 0.5, no sanctions hit, amount <= 2000, and first time payee == false | Involving: system\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.824196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_17\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"41025ece-357f-4d52-8e42-d167004a09f4\",\n      \"text\": \"Verifying a receipt requires only the artifact payload, corresponding public verification keys, and historical governance artifacts fetched via the receipt's stored references through a validation sequence comprising cryptographic integrity verification, governance reconstruction, and deterministic decision consistency check. | Involving: external verifying entities | Enables asynchronous, untrusted entity validation of policy compliance without requiring real-time agent presence\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.024690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_9\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"ca7ca72b-4e31-48f1-86ad-1697083da6a6\",\n      \"text\": \"An AI agent can only be assured if its governing requirements are considered part of the deployed model itself, since behavior of agents built on the same underlying model can vary depending on operational constraints. | Involving: AI agents, deployed models | Ensures consistent agent behavior under specified operational constraints for reliable governance\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.854196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_3\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"3ea90a8a-4d85-4e46-9f04-fe8ab9af3abc\",\n      \"text\": \"AgentBound-Bench is a standardized evaluation framework designed to quantify governance enforcement correctness, multi-authority composition behavior, and policy provenance integrity.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.964690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_11\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"ba1f50b8-205c-4432-b2f8-991f7ab8214d\",\n      \"text\": \"AgentBound-Bench is a standardized evaluation framework designed to quantify governance enforcement correctness, multi-authority composition behavior, and policy provenance integrity.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.964690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"08d6e4f2-5a13-45d7-beb8-7f565eafd40d\",\n      \"text\": \"PAGRL's reasoning trace log supports documentation and auditability requirements | Involving: PAGRL\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.078393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_28\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"c19a6296-1457-42e9-aecc-48fcb17bea3a\",\n      \"text\": \"Traditional authorization frameworks like Google Zanzibar Open Policy Agent and Cedar focus on entitlement validation for technical permissions while AgentBound establishes authorization as one governance input among independent arbiters evaluating contextual invariants beyond resource-level access control. These frameworks are insufficient for periodic or long-running agentic workloads because they operate under the implicit assumption that a human principal is actively present or within a valid session context when a transaction is initiated, creating systemic vulnerabilities where no human user is present to evaluate ambient risks when execution cycles spontaneously begin, and governance policies may shift between execution cycles; a runtime governance layer is needed to determine whether specific actions should occur under given circumstances.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.024690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"b184d623-9e11-40de-bada-82b84d4d726a\",\n      \"text\": \"AgentBound enforces deterministic compliance at the system runtime boundary rather than optimizing model weights at training time, focusing on verifiable system accountability rather than statistical behavioral shaping, fundamentally diverging from optimization-centric model alignment methods where alignment shapes model cognition beforehand and governance evaluates final behavior before system mutation, analogous to the software engineering boundary between application correctness and localized operational policy, without influencing agent cognition.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.004690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"a43a2e87-2a9b-412d-90b3-7f7e75897f56\",\n      \"text\": \"Irreversible actions (purchase orders, supplier commits, replenishment triggers) require explicit human confirmation before execution because they cannot be undone if incorrect | Irreversible actions cannot be undone if incorrect\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.078393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_22\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"2554d39d-574e-4142-8295-4320fd5ccf86\",\n      \"text\": \"Schema was validated on September 6, 2026 | When: 2026-09-06\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.814196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_7\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"c5e35a47-e5cd-4fc1-86a7-0368e309964a\",\n      \"text\": \"Policy Cards enable cross-framework compliance by embedding crosswalk tokens that operationalize NIST AIRMF, ISO/IEC 42001, and EU AI Act requirements simultaneously | When: 2026-09-06\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.824196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_29\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"0159c929-ee2e-453e-929d-b579bdb8fc24\",\n      \"text\": \"Controls section defines explicit action rules structured as ABAC tuples, each linking directly to evidence fields enumerated in the card: kyc status, risk score, device trust level, beneficiary screening score, escalation id, ensuring every decision is auditable | Involving: Cletus (AI agent), PolicyCard system\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.834196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_16\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"5c830e5b-749a-4ecb-840e-f48ad967e36f\",\n      \"text\": \"Policy engine design bridging governance requirements to runtime enforcement for agentic AI systems | When: 2025 | Involving: Jackson | Systematic approach for agentic AI system governance from requirements to runtime enforcement\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.138393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_36\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"b067f5d2-b3fc-4b1a-b94c-9378e52c6dc1\",\n      \"text\": \"NIST AI Risk Management Framework, ISO/IEC 42001:2023, and EU AI Act (2024) define governance requirements textually but do not prescribe how to represent information in verifiable, machine-readable structure. | Involving: NIST, ISO/IEC, EU AI Act frameworks | Frameworks share goals of traceability, accountability, and risk control but stop short of prescribing concrete technical artifacts\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.834196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_3\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"460744ac-83ed-4c88-bd62-0ed9671f99c9\",\n      \"text\": \"Traditional authorization frameworks (Google Zanzibar, Open Policy Agent, Cedar) focus on entitlement validation for technical permissions to access resources, while AgentBound establishes authorization as one governance input among independent arbiters to evaluate contextual invariants beyond resource-level access control | Involving: Google Zanzibar, Open Policy Agent, Cedar, AgentBound\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.024690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_13\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"a56f4d03-088f-4404-8927-06762407570d\",\n      \"text\": \"In Scenario 3, agent intends to contact unverified supplier not in verified registry; PAGRL retrieves rules R2, R4, R6; agent reasons contacting unverified supplier violates R4 but task can use verified alternative; compliance decision Self-Correct; agent revises intent to nearest verified supplier and re-enters PAGRL producing Proceed decision; original intent, correction reasoning, and revised intent logged to MCP governance server | Involving: supply chain agent, PAGRL system, MCP governance server, verified supplier | Unverified supplier contact violates compliance rules but alternative exists\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.088393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_24\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"b1d52bf4-f371-46c0-bd2c-c747549de35b\",\n      \"text\": \"AgentBound is out of scope for adversarial prompt injection attacks, direct LLM jailbreaks, baseline model alignment failures, and hardware-level side-channel data exfiltration, as AgentBound isolates behavior at the action perimeter rather than filtering cognitive model inputs, rendering it incapable of directly intercepting prompt injection, jailbreaks, or internal adversarial model manipulation\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.014690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"6927b614-7521-47ab-825d-e8b2cba8a88d\",\n      \"text\": \"The AgentBound-Bench evaluation framework, comprising compiled benchmark scenarios, baseline ground-truth annotations, out-of-band receipt verification tooling, and deployment documentation, will be released to the community upon conclusion of the initial empirical evaluation campaign.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.034690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_16\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"e58a9061-ab9e-497c-9703-7e07f5085655\",\n      \"text\": \"AgentBound trust assumptions require uncompromised core enforcement engine, signing keys, and policy registries, governance evaluations before action dispatch, and governance receipts stored in append-only tamper-evident audit ledger.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.024690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"88c903f8-7876-4950-9566-6ca94cc0d1f7\",\n      \"text\": \"Three conditions trigger escalation rather than self-correction: (1) categorical prohibition by rule where no intent revision makes it compliant, (2) irreversible action requiring human confirmation, (3) genuine uncertainty about permissibility where ambiguous cases should be escalated\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.118393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_16\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"c6acbadf-dfe3-4cad-b223-2e93013e3dbf\",\n      \"text\": \"Associated with DOI:10.5281/zenodo.17464706 | When: 2026-09-06 | Involving: user\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.844196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_33\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"348eb115-dbdc-4604-a5cd-876d5960997a\",\n      \"text\": \"AgentBound-Bench quantifies framework efficacy through four core mathematical and system metrics: governance accuracy (correct decisions/total decisions), violation escape rate (violations executed/total violations), receipt verification success rate, and fine-grained governance latency\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.974690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"0330d566-dc94-4a1b-b602-3b9c7048d944\",\n      \"text\": \"Review subsection requires 'owner', 'cadence_days', and 'method' as mandatory properties\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.844196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_14\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"2a66b637-8c11-457d-92ca-22880783a13d\",\n      \"text\": \"Agents can be authenticated, within valid OAuth/IAM scope, and compliant with static access policies yet still execute decisions violating their principal's intent through behavioral deviations including premature financial transactions, unreviewed content publication, sensitive information leakage under adversarial manipulation, or selecting irreversible actions when safe alternatives exist | When: 2026-09-06 | Involving: agent, principal\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.974690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_1\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"ab89c7ba-43e1-4bb0-a269-959bcbfc8b8c\",\n      \"text\": \"PolicyCard framework validated through multiple applied scenarios across sectors with distinct regulatory and evidentiary demands, including retail banking, clinical triage, and a defense-oriented case study, demonstrating how the same schema structure can encode operational rules, evidence requirements, and assurance mappings specific to each domain while remaining validator-clean and semantically consistent | Involving: Cletus (AI agent), financial institutions, regulatory bodies\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.814196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_16\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"30665448-4bff-4598-93d8-522a4e6a656d\",\n      \"text\": \"Future PolicyCard implementations can integrate cryptographic techniques for verifiable, privacy-preserving assurance, particularly Key-ScopedPolicyEncryption (using PKI where only authorized agents identified by signing keys can decrypt and interpret the card) and Zero-Knowledge Proofs for Policy Adherence (allowing agents to assert compliance with conditions like no unauthorized data exfiltration without disclosing underlying data) | Involving: AI agents, oversight agents, regulators | Enables verifiable compliance confirmation without exposing proprietary rules or underlying data\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.844196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_24\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"e6601d88-b0dc-4e17-8000-8a49013b05ee\",\n      \"text\": \"Two-level standing delegation model empowers persistent periodic agents to operate asynchronously under dynamically refreshed governance policies while preserving immediate user revocability and bounding credential exposure\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.994690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_17\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"5d210652-9757-4e1c-8041-9597a89b2583\",\n      \"text\": \"PAGRL framework requires agents to retrieve governance rules and reason about permissibility before taking consequential actions, determining one of three outcomes: proceed, self-correct, or escalate to human oversight | Involving: Cletus (AI agent) | All outcomes generate an auditable reasoning trace; ensures actions comply with governance rules\",\n      \"fact_type\": \"experience\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.078393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_12\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"3b0efb48-2848-40f8-a89c-450e1ccb95fe\",\n      \"text\": \"Future multi-agent ecosystems must demand rigorous behavioral oversight alongside baseline identity federation and token authorization\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.024690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"2e7daa02-c724-4227-a768-59a418a089a1\",\n      \"text\": \"Future multi-agent ecosystems must demand rigorous behavioral oversight alongside baseline identity federation and token authorization\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.024690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_17\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"b6cfb7a4-3188-4112-95b4-13acc6959fd8\",\n      \"text\": \"Agents reason against governance rules afresh each session with no persistent rule memory between invocations; consistency sensitive to rule formulation quality and injection completeness | Involving: PAGRL agents | Requires careful engineering and ongoing maintenance as workflows and organizational requirements evolve\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.098393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_27\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"abac8614-a764-486e-8519-e9bb72e01006\",\n      \"text\": \"Multi-party governance chapters are required to support federated environments involving overlapping stakeholders such as enterprise deployers, infrastructure providers, and sovereign regulators.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.004690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"8b854da1-4dfd-44fd-a9e6-cbc918da7904\",\n      \"text\": \"Multi-party governance chapters are required to support federated environments involving overlapping stakeholders such as enterprise deployers, infrastructure providers, and sovereign regulators.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.004690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_16\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"f02da273-a471-4124-928a-fb4960c2b518\",\n      \"text\": \"Monitoring section requires 'logging', 'detectors', and 'review' as mandatory properties\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.824196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_14\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"d28afb9c-cac8-4486-ae03-f2fbad8a8192\",\n      \"text\": \"Full schema and validator available in public repository and archived via Zenodo (DOI: 10.5281/zenodo.17464706)\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.844196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_10\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"88e21077-2e6f-42d8-aa60-8fc54438a2f5\",\n      \"text\": \"OAuth 2.0 token exchange protocol specified by Michael Jones, Anthony Nadalin, Brian Campbell, John Bradley, and Chuck Mortimore in a 2020 technical report\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.964690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"1d02196e-7f2e-4878-b991-feaec5020ea8\",\n      \"text\": \"Behavioral governance is emerging as a foundational architectural requirement for autonomous AI workloads in enterprise infrastructure and automated operational pipelines rather than an optional administrative feature\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.014690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_17\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"15901f26-3b4d-4d81-b057-fd8301d552bd\",\n      \"text\": \"The framework formalizes compliance as executable policy specifying allowed actions, required evidence, and assurance measurement for both humans and AI agents | When: 2026-09-06\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.834196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_29\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"83a18411-f4cf-42ee-bfc3-847b2a9b4aee\",\n      \"text\": \"The framework unifies four principals into a non-bypassable governance pipeline: Owner defines intent profile IO and authorizes delegation, Agent proposes actions, AgentBound Service enforces joint multi-authority policy M, Site Resource Provider hosts target resources; the pipeline sequentially evaluates, logs, and validates agent behaviors before execution, with security guarantees assuming strict operational sequence where governance evaluation occurs non-bypassably prior to execution\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.014690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"96f19be1-305e-492e-949d-f18c328789a6\",\n      \"text\": \"AgentBound addresses a fundamentally orthogonal axis to conventional benchmarks, focusing on runtime governance mechanisms rather than task optimization or task completion rates.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.014690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_11\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"02e2b155-7f91-4e20-8a2f-fb3ee17a42b9\",\n      \"text\": \"Defense mission-planning Policy Card prohibits autonomous kinetic actions (deny), requires escalation for target designations, enforces blue-force deconfliction, and logs immutable override audits\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.854196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_20\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"ce770419-1c35-453d-90f5-7152f01d8ee6\",\n      \"text\": \"Agent identifies supply chain risk from unverified supplier not explicitly covered by Rule R4, demonstrating normative generalization through LLM reasoning rather than deterministic rule-matching | Involving: Cletus (agent), Rule R4 | Key innovation: governance embedded in LLM reasoning enables normative generalization beyond explicit rule conditions\",\n      \"fact_type\": \"experience\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.078393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_27\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"097c480b-5bba-4d8d-816c-b7aef63d21b3\",\n      \"text\": \"AgentBound framework provides verifiable behavioral oversight for autonomous AI agents by evaluating proposed actions through three independent authorities (delegated authorization, owner-signed behavioral constitutions, and site action contracts) with conservative composition through a formal decision model determining whether actions should be permitted, reviewed, or denied before execution | When: 2026-09-06 | Involving: Anuj Kaul, Qianlong Lan, Pranay Gupta | Addresses gap in agent infrastructure where delegated authorization cannot determine whether authorized actions should execute under current behavioral and operational context\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.964690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_0\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"ab55978c-ac00-4561-a06d-57e251c88cef\",\n      \"text\": \"Combined encryption and Zero-Knowledge Proofs create a confidential assurance layer enabling operational compliance verification across distributed environments without revealing sensitive information, particularly useful in cross-border, regulated, or classified deployments where data-sharing is restricted | Involving: AI agents, oversight agents in cross-border/regulated contexts | Balances compliance verification with data privacy in sensitive deployment scenarios\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.854196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_24\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"aae10560-5efd-4918-a840-ba56be792392\",\n      \"text\": \"AgentBound addresses situations where fully authenticated and legitimately authorized agents execute actions violating principal intent while remaining within delegated access control scope | Demonstrates behavioral governance failures differ from access control breaches\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.994690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_14\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"70f9f8b6-24ac-4f68-8cc4-a3f83f8ba87d\",\n      \"text\": \"AgentBound trust assumptions require uncompromised cryptographic keys for Owner and AgentBound service, governance evaluations before action dispatch, and governance receipts stored in append-only tamper-evident audit ledger\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.004690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_5\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"d5358040-7b3c-4b37-b00d-02db89898e5d\",\n      \"text\": \"Example governance receipt (Table 1): Receipt ID r-1024, Agent ID ads-agent, Action launch campaign, Delegation Ref d-118, Constitution Version 3, Final Decision Human Approval Required with 7 Standing Delegation for Persistent Agents. | Involving: ads-agent + governance receipt system | Provides concrete example of the governance receipt structure and fields\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.014690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_9\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"bb79e459-896d-4018-b850-e37244516673\",\n      \"text\": \"Neurocognitive governance framework has direct implications for organizations under emerging AI regulatory frameworks; EU AI Act requires risk management systems throughout AI lifecycle for high-risk systems | Involving: Organizations operating under AI regulatory frameworks | Framework connects neurocognitive governance to concrete regulatory compliance requirements\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.128393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_27\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"e573f354-0387-45e1-ad99-2aa764a9c0f6\",\n      \"text\": \"Agent behavioral contracts: Formal specification and runtime enforcement for reliable autonomous AI agents by Varun Pratap Bhardwaj proposed in arXiv 2026, addressing agent reliability through formal methods and runtime enforcement | When: 2026 | Involving: Varun Pratap Bhardwaj\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.004690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_18\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"aeb897fe-6181-494f-9833-f31d0d52fd60\",\n      \"text\": \"Four-layer governance architecture should be mapped explicitly to EU AI Act and NIST AI Risk Management Framework requirements for compliance pathway | When: 2026-09-06 | Involving: Cletus (AI agent)\",\n      \"fact_type\": \"experience\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.088393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_35\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"a419c7dd-abd7-43dd-9be2-3a528ea59523\",\n      \"text\": \"Card mandates active risk detectors with numeric thresholds and declares all required log fields: HighRiskScore(>= 0.7), VelocitySpike(> 3 within 1h), GeoMismatch(== 1), SanctionsSoftMatch Lower Bound(>= 0.6) and Upper Bound(< 0.8) | Involving: Cletus (AI agent), PolicyCard system\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.844196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_16\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"c7f73850-8058-4de1-b6d9-311d443326f6\",\n      \"text\": \"AgentBound is a modular runtime governance and behavioral accountability framework for autonomous agents | Establishes behavioral governance as distinct from identity federation, access control, or training-time model alignment\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.964690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_14\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"1c96da96-913b-495c-9fca-82d8c1c5817f\",\n      \"text\": \"AgentBound generates cryptographically verifiable governance receipts that bind every action to exact delegation, policy, and semantic artifacts, enabling independent replay verification and policy provenance for accountability | When: 2026-09-06 | Involving: Anuj Kaul, Qianlong Lan, Pranay Gupta | Provides cryptographic provenance for agent actions rather than requiring trust in governance processes\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.974690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_0\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"56b62400-7c29-48b3-a728-ec4b13e97a82\",\n      \"text\": \"Only suppliers present in the verified supplier registry may be contacted because unverified suppliers introduce supply chain and compliance risk | Unverified suppliers introduce supply chain and compliance risk\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.098393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_22\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"6e953bb2-4b86-4eff-b1cd-f8ba84bd0eed\",\n      \"text\": \"AgentBound-Bench quantifies framework efficacy through four core mathematical and system metrics: governance accuracy (correct decisions/total decisions), violation escape rate (violations executed/total violations), receipt verification success rate, and fine-grained governance latency | When: 2026-09-06\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.974690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_12\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"d71c59c5-e8fc-445b-83bb-992b55ed9459\",\n      \"text\": \"AgentBound framework mitigates semantic and behavioral threats after traditional authorization concludes, detecting runtime behavioral policy violations and unauthorized execution bypassing approval workflows.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.994690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"5c382421-a18e-45dc-a0fe-39b878c0a920\",\n      \"text\": \"Establishing interoperable governance receipt standards represents a critical path toward unified accountability across heterogeneous multi-agent ecosystems.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.014690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_16\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"4a71566e-6bd0-4445-9378-0e1a9bbe3c92\",\n      \"text\": \"The Policy Card framework enables verifiable compliance for autonomous agents through automatic validation, version control, and integration with runtime enforcement or continuous-audit pipelines, forming a foundation for distributed assurance in multi-agent ecosystems | Involving: autonomous agents\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.834196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_0\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"8c975716-819f-478f-9c94-4a25bb367bfc\",\n      \"text\": \"Obligations are auditable commitments linked to evidence fields under specified conditions, including mandatory notifications, consent checks, and safety statements.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.844196+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"53796e6b-b18f-433e-8190-551db9236caa\",\n      \"text\": \"AgentBound builds upon RFC 8693 (OAuth 2.0 Token Exchange) standard for programmatic token transformation and delegation chain security | Provides formal semantic foundations for programmatic token transformation and delegation chain security within distributed environments\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.984690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_14\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"fc44fe51-caf6-4e49-98c6-497bd46b4e49\",\n      \"text\": \"ClinicalTriagePolicyCard formalizes three key obligations: provide only advisory outputs supported by evidence and disclaimers, escalate any red-flag condition to qualified personnel or emergency services, and deny any autonomous diagnosis or prescription\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.814196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_19\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"29368a8f-9e74-4a97-9083-cb67644e4c44\",\n      \"text\": \"An action receives physical execution clearance if and only if the final composed decision evaluates to Permit AND all accumulated runtime obligations are fully satisfied; satisfying review obligations fulfills behavioral policy requirements but does not alter the underlying authorization boundary. | Defines the precise condition for action execution within the governance pipeline.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.974690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_7\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"8512a3ae-3f39-408e-9e06-1a6de45832ac\",\n      \"text\": \"Governance receipt structured as tuple (Action, Governance, Judgments, Outcome, Signatures) capturing delegation token identifier, constitution version number with cryptographic hash, site action contract version identifier, individual typed evaluations, final operational primitive, and asymmetric cryptographic metadata | Involving: system | guarantees global integrity and non-repudiation\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.004690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_8\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    }\n  ],\n  \"trace\": null,\n  \"entities\": null,\n  \"chunks\": null,\n  \"source_facts\": null\n}"
  }
}
