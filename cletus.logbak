    }
  },
  "content": [
    {
      "text": "{\n  \"results\": [\n    {\n      \"id\": \"cc5557b5-112d-4947-97ff-0956d800a6fa\",\n      \"text\": \"Aegon implements hardware-attested compliance mechanisms with ledger-bound token architectures and cryptographically signed mobile receipts for safeguarding content extraction and data access controls.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.004690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"36ede801-86d4-4651-a827-d694a4b8f054\",\n      \"text\": \"Aegon implements hardware-attested compliance mechanisms with ledger-bound token architectures and cryptographically signed mobile receipts for safeguarding content extraction and data access controls | Involving: Aegon\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.004690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_13\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"ccddb16f-8088-4321-ae2f-a3a22b2d95a0\",\n      \"text\": \"OAuth 2.0 token exchange protocol specified by Michael Jones, Anthony Nadalin, Brian Campbell, John Bradley, and Chuck Mortimore in a 2020 technical report, providing a standard for OAuth 2.0 token exchange | When: 2020 | Involving: Michael Jones, Anthony Nadalin, Brian Campbell, John Bradley, Chuck Mortimore\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.964690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_18\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"3ea90a8a-4d85-4e46-9f04-fe8ab9af3abc\",\n      \"text\": \"AgentBound-Bench is a standardized evaluation framework designed to quantify governance enforcement correctness, multi-authority composition behavior, and policy provenance integrity.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.964690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_11\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"ba1f50b8-205c-4432-b2f8-991f7ab8214d\",\n      \"text\": \"AgentBound-Bench is a standardized evaluation framework designed to quantify governance enforcement correctness, multi-authority composition behavior, and policy provenance integrity.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.964690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"b184d623-9e11-40de-bada-82b84d4d726a\",\n      \"text\": \"AgentBound enforces deterministic compliance at the system runtime boundary rather than optimizing model weights at training time, focusing on verifiable system accountability rather than statistical behavioral shaping, fundamentally diverging from optimization-centric model alignment methods where alignment shapes model cognition beforehand and governance evaluates final behavior before system mutation, analogous to the software engineering boundary between application correctness and localized operational policy, without influencing agent cognition.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.004690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"9d3abc10-3fb0-42ec-bd9f-59c6b8ca2ce1\",\n      \"text\": \"AgentBound constitutes an administrative governance and behavioral accountability layer rather than a totalizing agent security architecture, extending traditional observability by generating atomic governance receipts encapsulating exact policy version states, delegation token identifiers, individual authority judgments, terminal outcomes, and asymmetric cryptographic signatures, with every discrete transaction encapsulated within a cryptographically signed governance receipt enabling independent out-of-band decision reconstruction and completely reconstructing the original decision algebra out-of-band. Example governance receipt structure includes Receipt ID r-1024 for Agent ID ads-agent performing Action launch campaign under Delegation Ref d-118 with Constitution Version 3, resulting in Final Decision Human Approval Required with 7 Standing Delegation for Persistent Agents.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.024690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"fc319743-84cc-4fa3-85c2-e797f87c66f1\",\n      \"text\": \"AgentBound is implemented as a decoupled, runtime governance layer positioned directly before action execution, serving as a non-bypassable governance checkpoint that evaluates candidate tool invocations using formal decision algebra to compose intermediate judgments conservatively prior to target system mutation. The agent runtime is treated as untrusted due to potential jailbreaks, requiring out-of-band validation prior to system execution.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.004690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"d25b8049-1949-47f6-b085-f2a450ca765c\",\n      \"text\": \"AgentBound's two-level delegation: standing delegation (long-term, human-authorized) authorizes short-lived task delegation per execution cycle; standing delegations restricted from direct execution, serving as root of authority for runtime engine, empowering persistent periodic agents to operate asynchronously under dynamically refreshed governance policies while preserving immediate user revocability and bounding credential exposure.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.994690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"f9eaca83-9be5-42f6-a5ca-0b944aad53d0\",\n      \"text\": \"Verifying a receipt requires the artifact payload, corresponding public verification keys, and historical governance artifacts fetched via the receipt's stored references through a validation sequence comprising cryptographic integrity verification, governance reconstruction, and deterministic decision consistency check.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.024690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"b1d52bf4-f371-46c0-bd2c-c747549de35b\",\n      \"text\": \"AgentBound is out of scope for adversarial prompt injection attacks, direct LLM jailbreaks, baseline model alignment failures, and hardware-level side-channel data exfiltration, as AgentBound isolates behavior at the action perimeter rather than filtering cognitive model inputs, rendering it incapable of directly intercepting prompt injection, jailbreaks, or internal adversarial model manipulation\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.014690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"88c903f8-7876-4950-9566-6ca94cc0d1f7\",\n      \"text\": \"Three conditions trigger escalation rather than self-correction: (1) categorical prohibition by rule where no intent revision makes it compliant, (2) irreversible action requiring human confirmation, (3) genuine uncertainty about permissibility where ambiguous cases should be escalated\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.118393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_16\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"6f577b37-deb9-4f1d-bdaf-8814da26b4c6\",\n      \"text\": \"Canonical action tuple (operation, resource, parameters, risk, context) abstracts all runtime events where operation identifies semantic intent, resource denotes target, parameters encompass action-specific arguments, risk encapsulates exposure category, and context contains volatile execution metadata\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.974690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_6\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"a13b6643-bbf0-4787-803a-72f7d1c81b0b\",\n      \"text\": \"Documentation/specs/templates/examples: CC BY 4.0\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.854196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_31\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"96f19be1-305e-492e-949d-f18c328789a6\",\n      \"text\": \"AgentBound addresses a fundamentally orthogonal axis to conventional benchmarks, focusing on runtime governance mechanisms rather than task optimization or task completion rates.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.014690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_11\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"88e21077-2e6f-42d8-aa60-8fc54438a2f5\",\n      \"text\": \"OAuth 2.0 token exchange protocol specified by Michael Jones, Anthony Nadalin, Brian Campbell, John Bradley, and Chuck Mortimore in a 2020 technical report\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.964690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"d71c59c5-e8fc-445b-83bb-992b55ed9459\",\n      \"text\": \"AgentBound framework mitigates semantic and behavioral threats after traditional authorization concludes, detecting runtime behavioral policy violations and unauthorized execution bypassing approval workflows.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.994690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"348eb115-dbdc-4604-a5cd-876d5960997a\",\n      \"text\": \"AgentBound-Bench quantifies framework efficacy through four core mathematical and system metrics: governance accuracy (correct decisions/total decisions), violation escape rate (violations executed/total violations), receipt verification success rate, and fine-grained governance latency\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.974690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"b4e51bad-15c5-4172-bef7-e9f2aeb3c8d7\",\n      \"text\": \"Assurance mappings reference NIST (GOVERN-1, MAP-1, MEASURE-1, MANAGE-1, MANAGE-3), ISO42001 (4,8,9,10), and EU AI Act (AnnexIV-3,4,6,9, Art72) for programmatic traceability.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.834196+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"ab7eeb37-d728-4d3f-894c-16ac5242b4d0\",\n      \"text\": \"PolicyCards express explicit normative constraints (allow/deny/escalation) tied directly to measurable evidence fields, critical thresholds, and retention cadences, enabling deterministic compliance checking and continuous audit trails rather than periodic manual reviews. | Replaces periodic manual reviews with deterministic, continuous compliance assurance for AI systems.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.834196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_5\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"0a645c4e-dbb9-4b11-a236-4ef68381e3b9\",\n      \"text\": \"Obligations include user notices (fees/limits), explicit consent recording, escalation protocol enforcement, and audit-trail maintenance\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.824196+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"c19a6296-1457-42e9-aecc-48fcb17bea3a\",\n      \"text\": \"Traditional authorization frameworks like Google Zanzibar Open Policy Agent and Cedar focus on entitlement validation for technical permissions while AgentBound establishes authorization as one governance input among independent arbiters evaluating contextual invariants beyond resource-level access control. These frameworks are insufficient for periodic or long-running agentic workloads because they operate under the implicit assumption that a human principal is actively present or within a valid session context when a transaction is initiated, creating systemic vulnerabilities where no human user is present to evaluate ambient risks when execution cycles spontaneously begin, and governance policies may shift between execution cycles; a runtime governance layer is needed to determine whether specific actions should occur under given circumstances.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.024690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"7725ee7c-c8d0-4d78-ac9a-a6a6058fd260\",\n      \"text\": \"Framework positions Policy Cards as foundation for autonomous assurance ecosystems where policies are computational, verifiable, and privacy-preserving.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.894196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_26\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"c05bbc37-af59-4173-b2f7-1bf9f86026f6\",\n      \"text\": \"AgentBound framework mitigates semantic and behavioral threats after traditional authorization concludes, detecting runtime behavioral policy violations and unauthorized execution bypassing approval workflows\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.994690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_5\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"a43a2e87-2a9b-412d-90b3-7f7e75897f56\",\n      \"text\": \"Irreversible actions (purchase orders, supplier commits, replenishment triggers) require explicit human confirmation before execution because they cannot be undone if incorrect | Irreversible actions cannot be undone if incorrect\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.078393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_22\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"5c382421-a18e-45dc-a0fe-39b878c0a920\",\n      \"text\": \"Establishing interoperable governance receipt standards represents a critical path toward unified accountability across heterogeneous multi-agent ecosystems.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.014690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_16\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"c0a57016-bbb1-4236-b908-061dd5f0c424\",\n      \"text\": \"Establishing interoperable governance receipt standards represents a critical path toward unified accountability across heterogeneous multi-agent ecosystems.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.014690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"e424c3cc-a088-4727-ab5e-5e4f0106affa\",\n      \"text\": \"PolicyCards act as structured metadata describing both operational policy and its cryptographic verification envelope\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.814196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_25\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"2cfeb6c9-0b76-4b8c-94a4-33c598e569df\",\n      \"text\": \"Task delegation short-lived credential derived from standing delegation boundaries, encapsulating task ID, constrained operational scope, issuance timestamp, short-lived expiration threshold, and governing constitution reference.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.974690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"24515944-a2ee-4e84-a169-c54cebea0f78\",\n      \"text\": \"Formal Runtime Enforcement uses deterministic pipeline to synthesize complementary judgments from independent authorities through conservative decision algebra before action execution\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.984690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_2\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"1f55871f-c942-4823-a7fc-413ae9c915bd\",\n      \"text\": \"Model Cards, DataCards, and SystemCards communicate how AI systems were trained or tested but do not specify how they must behave under operational, regulatory, or contractual constraints. | Involving: Model Cards, DataCards, SystemCards (transparency artifact types) | These artifacts improve transparency across the model lifecycle but lack binding deployment policy specification\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.824196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_3\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"72c99091-4148-46fd-8619-6cad5815794f\",\n      \"text\": \"Attack succeeds when RS(α)=Valid AND α∉IO, exploiting cognitive ambiguity, semantic uncertainty, or incomplete governance rule specifications\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.984690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_5\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"8b30d9ca-5d0a-4216-b346-2786123bd6e0\",\n      \"text\": \"Zanzibar, Google's consistent global authorization system presented at USENIX ATC 2019 by Ruoming Pang, Ramon Caceres, Mike Burrows, Zhifeng Chen, Pratik Dave, Nathan Germer, Alexander Golynski, Kevin Graney, Nina Kang, Lea Kissner, et al., enabling fine-grained distributed authorization | When: 2019 | Involving: Ruoming Pang, Ramon Caceres, Mike Burrows, et al. (Google)\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.974690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_18\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"42694569-e601-4d09-b194-5f7e1f9199ab\",\n      \"text\": \"RS(α) is the standard access control and delegation verification function for site S under delegated authorization scope Gauth\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.964690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_5\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"ab55978c-ac00-4561-a06d-57e251c88cef\",\n      \"text\": \"Combined encryption and Zero-Knowledge Proofs create a confidential assurance layer enabling operational compliance verification across distributed environments without revealing sensitive information, particularly useful in cross-border, regulated, or classified deployments where data-sharing is restricted | Involving: AI agents, oversight agents in cross-border/regulated contexts | Balances compliance verification with data privacy in sensitive deployment scenarios\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.854196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_24\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"f914205a-ea5f-4dbd-9ad8-c2af55adafa8\",\n      \"text\": \"PAGRL escalation operationalizes the \",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.108393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_16\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"046adb4b-3d25-484e-982b-f50d21ada88e\",\n      \"text\": \"Cedar, a new language for expressive, fast, safe, and analyzable authorization introduced by Joseph W Cutler, Craig Disselkoen, Aaron Eline, Shaobo He, Kyle Headley, Michael Hicks, Kesha Hietala, Eleftherios Ioannidis, John Kastner, Anwar Mamat, et al. in PLDI 2024, offering improved authorization capabilities | When: 2024 | Involving: Joseph W Cutler, Craig Disselkoen, Aaron Eline, et al.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.984690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_18\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"53796e6b-b18f-433e-8190-551db9236caa\",\n      \"text\": \"AgentBound builds upon RFC 8693 (OAuth 2.0 Token Exchange) standard for programmatic token transformation and delegation chain security | Provides formal semantic foundations for programmatic token transformation and delegation chain security within distributed environments\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.984690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_14\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"1a1552cc-5a3a-488c-97be-1ae7df0d6873\",\n      \"text\": \"Adaptive governance research aims to create dynamic constitutions capable of updating enforcement constraints in response to observed agent drift without invalidating cryptographic provenance.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.994690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_16\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"c42c76c0-27c5-48da-8ac6-e0ddcd5d4855\",\n      \"text\": \"Adaptive governance research aims to create dynamic constitutions capable of updating enforcement constraints in response to observed agent drift without invalidating cryptographic provenance.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.994690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"029b038b-467e-4e49-b552-f72e76fb3104\",\n      \"text\": \"Five core security invariants yielded by the verification architecture: integrity, non-repudiation, policy provenance, replay verifiability, and decision transparency. | Involving: system architecture | Defines the security properties guaranteed by the receipt verification system\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.984690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_9\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"41025ece-357f-4d52-8e42-d167004a09f4\",\n      \"text\": \"Verifying a receipt requires only the artifact payload, corresponding public verification keys, and historical governance artifacts fetched via the receipt's stored references through a validation sequence comprising cryptographic integrity verification, governance reconstruction, and deterministic decision consistency check. | Involving: external verifying entities | Enables asynchronous, untrusted entity validation of policy compliance without requiring real-time agent presence\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.024690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_9\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"caab4851-86fb-43b7-8aac-3dbbfc844b01\",\n      \"text\": \"Pre-Action Governance Reasoning Loop (PA-GRL) proposed as formal mechanism through which agents consult structured governance rule sets before every consequential action, determining whether to proceed, self-correct, or escalate to human oversight, mirroring human deliberative compliance behavior | Involving: agents/researchers | To formalize human-like compliance behavior in AI agent governance\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.088393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_3\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"ddcafc90-f61a-4567-8869-b661983c8f8c\",\n      \"text\": \"This work first formalizes mapping of neurocognitive theories (Dual Process Theory, executive function) to agent governance design and demonstrates practical viability through production-grade case study | Involving: Cletus | Novel contribution bridging cognitive science and AI governance; first explicit neurocognitive grounding for agent governance\",\n      \"fact_type\": \"experience\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.108393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_30\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"2ed71df4-c897-496e-a98a-c0c497131814\",\n      \"text\": \"AgentBound operates as a deterministic enforcement layer at the system boundary between authorization and execution, governing how physical actions are evaluated justified and recorded without influencing agent cognition\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.004690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_17\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"83252b8c-b117-421b-9278-63899514adad\",\n      \"text\": \"Constraints aggregate conjunctively and obligations accumulate cumulatively within the decision composition engine, with structural provenance records required to be preserved intact throughout the governance process. | Describes the monotonic invariants governing how parallel judgment vectors unify into singular runtime directives.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.034690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_7\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"7fa86949-9d37-41b5-9c5b-223a68f61e36\",\n      \"text\": \"Banks, hospitals, and public agencies require guarantees that AI system decisions are reliable\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.844196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_4\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"df03b55d-35c8-4637-ad6c-d5f78f4bb29c\",\n      \"text\": \"The Delegation Service manages the structural scope of authorized capability issued to the agent, handling token issuance, structural revocation, and delegation freshness validation. | Defines how authorized capabilities are structurally managed and maintained for agents.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.024690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_7\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"460744ac-83ed-4c88-bd62-0ed9671f99c9\",\n      \"text\": \"Traditional authorization frameworks (Google Zanzibar, Open Policy Agent, Cedar) focus on entitlement validation for technical permissions to access resources, while AgentBound establishes authorization as one governance input among independent arbiters to evaluate contextual invariants beyond resource-level access control | Involving: Google Zanzibar, Open Policy Agent, Cedar, AgentBound\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.024690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_13\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"f6bca91d-74f8-40c9-9138-f676e7b5cb76\",\n      \"text\": \"Action rules follow ASI-[A-Z0-9-]+ pattern format\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.844196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_9\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"8c5efac0-79ab-4efd-8edd-25bd4df9324d\",\n      \"text\": \"PolicyCards framework enables policy declaration, controlled execution, evidence capture and automated audit feedback for AI systems governance\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.814196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_22\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"b483f60c-ba7b-454b-b3dc-7424c0af3151\",\n      \"text\": \"AgentBound constitutes an administrative governance and behavioral accountability layer rather than a totalizing agent security architecture\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.024690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_5\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"c7f73850-8058-4de1-b6d9-311d443326f6\",\n      \"text\": \"AgentBound is a modular runtime governance and behavioral accountability framework for autonomous agents | Establishes behavioral governance as distinct from identity federation, access control, or training-time model alignment\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.964690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_14\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"f7a8f54a-c157-4f82-9fbc-157d2c87d3e2\",\n      \"text\": \"Standing Delegation Architecture provides secure, long-running delegation mechanism for periodic autonomous agents preserving policy freshness and granular revocability\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.974690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_2\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"02110a14-b10c-4bd8-9320-345c886c8a18\",\n      \"text\": \"In Scenario 4, supplier disruption signal activates situational rule R7; inventory replenishment agent intends to substitute disrupted supplier with verified alternative; with R7 active, PAGRL reasons disruption context elevates risk regardless of verified status; compliance decision Escalate; structured escalation message including disruption context, proposed substitution, and reasoning trace transmitted to supply chain manager for review | Involving: inventory replenishment agent, PAGRL system, supply chain manager, MCP governance server | Disruption context elevates risk even for verified suppliers\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.098393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_24\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"c8b164c1-2307-4e8c-a04d-1d684218f37d\",\n      \"text\": \"Governance frameworks must incorporate tamper-resistance mechanisms to protect rule integrity against adversarial inputs | Involving: design requirement\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.118393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_11\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"6adfdf6d-4592-4ade-9534-16646fefb0c0\",\n      \"text\": \"AgentBound isolates behavior at the action perimeter rather than filtering cognitive model inputs, rendering it incapable of directly intercepting prompt injection, jailbreaks, or internal adversarial model manipulation | When: 2026-09-06 | Involving: AgentBound framework\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.004690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_15\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"ffa08b87-9789-4d6a-8029-962f79dfad88\",\n      \"text\": \"PolicyCards require three autonomous checks before any action: authorization evaluation (verifying proposed actions satisfy controls preconditions), obligation assessment (confirming mandatory evidence requirements can be satisfied), and contextual validation (checking environmental constraints like jurisdiction, operational mode, or time window against scope) | Involving: AI agents operating under PolicyCards | Establishes controlled, policy-aware action execution in autonomous systems\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.814196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_24\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"73b2bfda-06e7-440d-ad53-71a33a3aebbe\",\n      \"text\": \"Event date recorded as Sunday, September 06, 2026 | When: Sunday, September 06, 2026\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.814196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_13\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"83c65de1-4669-481f-9d10-984c6838a241\",\n      \"text\": \"Zanzibar, Google's consistent global authorization system presented at USENIX ATC 2019 by Ruoming Pang, Ramon Caceres, Mike Burrows, Zhifeng Chen, Pratik Dave, Nathan Germer, Alexander Golynski, Kevin Graney, Nina Kang, Lea Kissner, et al.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.974690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"0bef11c9-21a3-4b35-852e-408f35185b30\",\n      \"text\": \"In collaborative scenarios (e.g., Clinical Trial Coordinator), agents exchange digital attestations representing partial fulfillment of obligations (e.g., data anonymization, consent verification, statistical integrity), verifiable by peers and aggregable into a composite assurance graph enabling federated compliance | Involving: AI agents in collaborative scenarios | Enables federated compliance where trust emerges from a network of mutually validating agents\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.834196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_24\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"a56f4d03-088f-4404-8927-06762407570d\",\n      \"text\": \"In Scenario 3, agent intends to contact unverified supplier not in verified registry; PAGRL retrieves rules R2, R4, R6; agent reasons contacting unverified supplier violates R4 but task can use verified alternative; compliance decision Self-Correct; agent revises intent to nearest verified supplier and re-enters PAGRL producing Proceed decision; original intent, correction reasoning, and revised intent logged to MCP governance server | Involving: supply chain agent, PAGRL system, MCP governance server, verified supplier | Unverified supplier contact violates compliance rules but alternative exists\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.088393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_24\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"9f47ee44-41e2-448c-8e79-61331aeda896\",\n      \"text\": \"RFC3339 timestamp format required for temporal fields\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.834196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_9\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"d8849b46-627f-4b04-93df-0900883c23a1\",\n      \"text\": \"AgentBound enforces deterministic compliance at the system runtime boundary rather than optimizing model weights at training time, focusing on verifiable system accountability rather than statistical behavioral shaping | Involving: AgentBound\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.984690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_13\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"6140b11f-4488-4a31-aafc-96bb9ad59836\",\n      \"text\": \"The reasoning trace log is queryable through the MCP interface, enabling human operators to inspect governance decisions in real time and supporting post-hoc compliance audit and review.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.108393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_19\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"0cdd3053-9292-40c6-86c2-608b98ed3880\",\n      \"text\": \"Procurement orders exceeding $10,000 require human approval before execution because high-value orders carry significant financial risk | High-value orders carry significant financial risk\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.088393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_22\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"6e953bb2-4b86-4eff-b1cd-f8ba84bd0eed\",\n      \"text\": \"AgentBound-Bench quantifies framework efficacy through four core mathematical and system metrics: governance accuracy (correct decisions/total decisions), violation escape rate (violations executed/total violations), receipt verification success rate, and fine-grained governance latency | When: 2026-09-06\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.974690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_12\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"9f4b9ed0-311d-491e-b0e5-df484fdf0191\",\n      \"text\": \"AgentBound framework integrates three governance authorities (delegated authorization, owner-signed behavioral constitutions, and site action contracts) into a unified multi-authority decision engine for autonomous systems.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.964690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"1acc06f1-e5fb-4d88-91c7-7cacb3ae3467\",\n      \"text\": \"Policy Cards are JSON-structured documents with semantic versioning (X.Y.Z) enabling traceable updates and diff-based analysis for auditors to verify what changed between policy revisions.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.814196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_6\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"d28afb9c-cac8-4486-ae03-f2fbad8a8192\",\n      \"text\": \"Full schema and validator available in public repository and archived via Zenodo (DOI: 10.5281/zenodo.17464706)\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.844196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_10\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"412755b8-775c-4002-89f0-4f58a9562c18\",\n      \"text\": \"Obligations include user notices (fees/limits), explicit consent recording, escalation protocol enforcement, and audit-trail maintenance | Involving: system | Framework requirements for compliance and traceability\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.824196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_18\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"471dc155-1cca-4e23-97d4-e16c418f5e29\",\n      \"text\": \"Behavioral adversary Abeh manipulates authorized agents into executing actions violating Owner's intent while remaining within delegated permission scope.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.974690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"093ea1a5-54fc-4037-88fe-85457b7b1ac7\",\n      \"text\": \"Policy Cards can reference related artifacts (Model, Data, or System Cards, DPIAs, risk registers) through unique identifiers and URIs, enabling modular governance where sub-component policies assemble into system-level composites.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.824196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_6\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"efb639e6-4532-4de4-bf99-12becf7f5ac3\",\n      \"text\": \"Adversarially crafted inputs may induce agents to rationalize non-compliant actions as permissible (functional analog of moral disengagement); framework lacks dedicated tamper-resistance layer | Involving: PAGRL agents | Governance robustness under systematic adversarial attack remains open empirical question\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.108393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_27\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"ce770419-1c35-453d-90f5-7152f01d8ee6\",\n      \"text\": \"Agent identifies supply chain risk from unverified supplier not explicitly covered by Rule R4, demonstrating normative generalization through LLM reasoning rather than deterministic rule-matching | Involving: Cletus (agent), Rule R4 | Key innovation: governance embedded in LLM reasoning enables normative generalization beyond explicit rule conditions\",\n      \"fact_type\": \"experience\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.078393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_27\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"e6601d88-b0dc-4e17-8000-8a49013b05ee\",\n      \"text\": \"Two-level standing delegation model empowers persistent periodic agents to operate asynchronously under dynamically refreshed governance policies while preserving immediate user revocability and bounding credential exposure\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.994690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_17\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"8644e70e-b152-4f7b-ad01-2aa2ed7b097c\",\n      \"text\": \"Validation performed using Ajv8.x JSON Schema validator with custom linting logic enforcing schema conformance and semantic relationships between fields beyond structural validation\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.904196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_8\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"f249bcfb-ac2d-4aac-9325-247e6ea3305f\",\n      \"text\": \"AgentBound evaluates candidate tool invocations non-bypassably before execution, using formal decision algebra to compose intermediate judgments conservatively\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.974690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_17\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"7ae8a1a2-6453-40ee-acb9-0c7c828714ac\",\n      \"text\": \"AgentBound governance model organized around three core tenets: separation of governance authorities, behavioral accountability, and replay verifiability\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.964690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_6\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"f888ed02-1f9a-404c-9ea5-0d0106a940ff\",\n      \"text\": \"Access control mechanisms dictate structural entitlement to resources, while AgentBound's governance determines whether specific canonical actions should occur under given runtime environmental variables | Highlights fundamental limitation of traditional authorization systems in expressing contextual behavioral variables\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.004690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_14\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"d24ba464-8811-43b3-9a48-63d218f8f051\",\n      \"text\": \"AgentBound's two-level delegation: standing delegation (long-term, human-authorized) authorizes short-lived task delegation per execution cycle; standing delegations restricted from direct execution, serving as root of authority for runtime engine | Involving: Cletus\",\n      \"fact_type\": \"experience\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.964690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_10\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"f9e87021-301e-4be2-92ca-cbd1e194fa4b\",\n      \"text\": \"Behavioral adversary Abeh manipulates authorized agents into executing actions violating Owner's intent while remaining within delegated permission scope\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.974690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_5\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"ee2af7b0-4fed-4f57-aeeb-6d843aec8279\",\n      \"text\": \"Schema conformance check ensures all required top-level keys present and no undefined properties introduced (additionalProperties: false), preventing unspecified properties in Policy Card structure\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.914196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_8\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"c93c9fd0-9eb3-4d1f-beff-8dd77b292670\",\n      \"text\": \"Policy Cards complement existing AI transparency tools by introducing a normative governance artifact directly tied to deployment, enabling organizations, auditors, and regulators to verify compliance at design and runtime instead of retrospectively | When: 2026-09-06 | Involving: Policy Cards positioning | Represents a shift from descriptive to normative AI governance\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.864196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_2\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"a682fd1a-0271-4273-a987-50d84bde23c2\",\n      \"text\": \"AgentBound introduces deterministic runtime behavioral oversight and cryptographically verifiable accountability mechanisms into the agent execution pipeline\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.994690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"555eee25-ea0b-492a-82e4-1734799f5d27\",\n      \"text\": \"Policy Cards encode ethical policies as structured commitments reflecting societal or organizational values.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.844196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_26\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"e566f3b5-5734-45e4-bdc2-4a8e1dce9a76\",\n      \"text\": \"Framework represents meaningful advance in trustworthiness of autonomous AI deployments | Involving: framework\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.128393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_28\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"11d4ee89-01b6-4056-9498-b92aca08cd31\",\n      \"text\": \"During supplier disruption events, all supplier substitution decisions require human review regardless of order value because disruption contexts introduce elevated supply chain risk | Disruption contexts introduce elevated supply chain risk\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.128393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_22\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"f37c14f6-560c-44e6-bd8a-0fd60f5a3098\",\n      \"text\": \"Receipt generation proceeds via a deterministic four-stage pipeline: evaluation, raw payload construction, two-phase ordered countersigning protocol, and verification architecture enabling asynchronous policy compliance validation by external untrusted entities. | Involving: system architecture | Establishes the complete receipt generation and verification process with five core security invariants\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.964690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_9\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"6ae98d7f-93a9-40cb-86b2-2fce61facff8\",\n      \"text\": \"AgentBound is implemented as a decoupled, runtime governance layer positioned directly before action execution, serving as a non-bypassable governance checkpoint that every consequential action must pass prior to target system mutation. | Establishes the architectural pattern for out-of-band validation of agent actions.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.994690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_7\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"26737e50-b69b-4fbb-b85f-56cee391b604\",\n      \"text\": \"Both humans and autonomous AI agents interact with their environments through the same mechanism where a reasoning source produces a natural language expression of intent that drives action, analogous to humans formulating instructions directed toward a task and AI agents formulating prompts directed toward an LLM\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.118393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_6\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    }\n  ],\n  \"trace\": null,\n  \"entities\": null,\n  \"chunks\": null,\n  \"source_facts\": null\n}",
      "type": "text"
    }
  ],
  "isError": false,
  "structuredContent": {
    "result": "{\n  \"results\": [\n    {\n      \"id\": \"cc5557b5-112d-4947-97ff-0956d800a6fa\",\n      \"text\": \"Aegon implements hardware-attested compliance mechanisms with ledger-bound token architectures and cryptographically signed mobile receipts for safeguarding content extraction and data access controls.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.004690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"36ede801-86d4-4651-a827-d694a4b8f054\",\n      \"text\": \"Aegon implements hardware-attested compliance mechanisms with ledger-bound token architectures and cryptographically signed mobile receipts for safeguarding content extraction and data access controls | Involving: Aegon\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.004690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_13\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"ccddb16f-8088-4321-ae2f-a3a22b2d95a0\",\n      \"text\": \"OAuth 2.0 token exchange protocol specified by Michael Jones, Anthony Nadalin, Brian Campbell, John Bradley, and Chuck Mortimore in a 2020 technical report, providing a standard for OAuth 2.0 token exchange | When: 2020 | Involving: Michael Jones, Anthony Nadalin, Brian Campbell, John Bradley, Chuck Mortimore\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.964690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_18\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"3ea90a8a-4d85-4e46-9f04-fe8ab9af3abc\",\n      \"text\": \"AgentBound-Bench is a standardized evaluation framework designed to quantify governance enforcement correctness, multi-authority composition behavior, and policy provenance integrity.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.964690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_11\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"ba1f50b8-205c-4432-b2f8-991f7ab8214d\",\n      \"text\": \"AgentBound-Bench is a standardized evaluation framework designed to quantify governance enforcement correctness, multi-authority composition behavior, and policy provenance integrity.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.964690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"b184d623-9e11-40de-bada-82b84d4d726a\",\n      \"text\": \"AgentBound enforces deterministic compliance at the system runtime boundary rather than optimizing model weights at training time, focusing on verifiable system accountability rather than statistical behavioral shaping, fundamentally diverging from optimization-centric model alignment methods where alignment shapes model cognition beforehand and governance evaluates final behavior before system mutation, analogous to the software engineering boundary between application correctness and localized operational policy, without influencing agent cognition.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.004690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"9d3abc10-3fb0-42ec-bd9f-59c6b8ca2ce1\",\n      \"text\": \"AgentBound constitutes an administrative governance and behavioral accountability layer rather than a totalizing agent security architecture, extending traditional observability by generating atomic governance receipts encapsulating exact policy version states, delegation token identifiers, individual authority judgments, terminal outcomes, and asymmetric cryptographic signatures, with every discrete transaction encapsulated within a cryptographically signed governance receipt enabling independent out-of-band decision reconstruction and completely reconstructing the original decision algebra out-of-band. Example governance receipt structure includes Receipt ID r-1024 for Agent ID ads-agent performing Action launch campaign under Delegation Ref d-118 with Constitution Version 3, resulting in Final Decision Human Approval Required with 7 Standing Delegation for Persistent Agents.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.024690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"fc319743-84cc-4fa3-85c2-e797f87c66f1\",\n      \"text\": \"AgentBound is implemented as a decoupled, runtime governance layer positioned directly before action execution, serving as a non-bypassable governance checkpoint that evaluates candidate tool invocations using formal decision algebra to compose intermediate judgments conservatively prior to target system mutation. The agent runtime is treated as untrusted due to potential jailbreaks, requiring out-of-band validation prior to system execution.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.004690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"d25b8049-1949-47f6-b085-f2a450ca765c\",\n      \"text\": \"AgentBound's two-level delegation: standing delegation (long-term, human-authorized) authorizes short-lived task delegation per execution cycle; standing delegations restricted from direct execution, serving as root of authority for runtime engine, empowering persistent periodic agents to operate asynchronously under dynamically refreshed governance policies while preserving immediate user revocability and bounding credential exposure.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.994690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"f9eaca83-9be5-42f6-a5ca-0b944aad53d0\",\n      \"text\": \"Verifying a receipt requires the artifact payload, corresponding public verification keys, and historical governance artifacts fetched via the receipt's stored references through a validation sequence comprising cryptographic integrity verification, governance reconstruction, and deterministic decision consistency check.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.024690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"b1d52bf4-f371-46c0-bd2c-c747549de35b\",\n      \"text\": \"AgentBound is out of scope for adversarial prompt injection attacks, direct LLM jailbreaks, baseline model alignment failures, and hardware-level side-channel data exfiltration, as AgentBound isolates behavior at the action perimeter rather than filtering cognitive model inputs, rendering it incapable of directly intercepting prompt injection, jailbreaks, or internal adversarial model manipulation\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.014690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"88c903f8-7876-4950-9566-6ca94cc0d1f7\",\n      \"text\": \"Three conditions trigger escalation rather than self-correction: (1) categorical prohibition by rule where no intent revision makes it compliant, (2) irreversible action requiring human confirmation, (3) genuine uncertainty about permissibility where ambiguous cases should be escalated\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.118393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_16\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"6f577b37-deb9-4f1d-bdaf-8814da26b4c6\",\n      \"text\": \"Canonical action tuple (operation, resource, parameters, risk, context) abstracts all runtime events where operation identifies semantic intent, resource denotes target, parameters encompass action-specific arguments, risk encapsulates exposure category, and context contains volatile execution metadata\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.974690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_6\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"a13b6643-bbf0-4787-803a-72f7d1c81b0b\",\n      \"text\": \"Documentation/specs/templates/examples: CC BY 4.0\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.854196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_31\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"96f19be1-305e-492e-949d-f18c328789a6\",\n      \"text\": \"AgentBound addresses a fundamentally orthogonal axis to conventional benchmarks, focusing on runtime governance mechanisms rather than task optimization or task completion rates.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.014690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_11\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"88e21077-2e6f-42d8-aa60-8fc54438a2f5\",\n      \"text\": \"OAuth 2.0 token exchange protocol specified by Michael Jones, Anthony Nadalin, Brian Campbell, John Bradley, and Chuck Mortimore in a 2020 technical report\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.964690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"d71c59c5-e8fc-445b-83bb-992b55ed9459\",\n      \"text\": \"AgentBound framework mitigates semantic and behavioral threats after traditional authorization concludes, detecting runtime behavioral policy violations and unauthorized execution bypassing approval workflows.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.994690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"348eb115-dbdc-4604-a5cd-876d5960997a\",\n      \"text\": \"AgentBound-Bench quantifies framework efficacy through four core mathematical and system metrics: governance accuracy (correct decisions/total decisions), violation escape rate (violations executed/total violations), receipt verification success rate, and fine-grained governance latency\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.974690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"b4e51bad-15c5-4172-bef7-e9f2aeb3c8d7\",\n      \"text\": \"Assurance mappings reference NIST (GOVERN-1, MAP-1, MEASURE-1, MANAGE-1, MANAGE-3), ISO42001 (4,8,9,10), and EU AI Act (AnnexIV-3,4,6,9, Art72) for programmatic traceability.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.834196+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"ab7eeb37-d728-4d3f-894c-16ac5242b4d0\",\n      \"text\": \"PolicyCards express explicit normative constraints (allow/deny/escalation) tied directly to measurable evidence fields, critical thresholds, and retention cadences, enabling deterministic compliance checking and continuous audit trails rather than periodic manual reviews. | Replaces periodic manual reviews with deterministic, continuous compliance assurance for AI systems.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.834196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_5\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"0a645c4e-dbb9-4b11-a236-4ef68381e3b9\",\n      \"text\": \"Obligations include user notices (fees/limits), explicit consent recording, escalation protocol enforcement, and audit-trail maintenance\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.824196+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"c19a6296-1457-42e9-aecc-48fcb17bea3a\",\n      \"text\": \"Traditional authorization frameworks like Google Zanzibar Open Policy Agent and Cedar focus on entitlement validation for technical permissions while AgentBound establishes authorization as one governance input among independent arbiters evaluating contextual invariants beyond resource-level access control. These frameworks are insufficient for periodic or long-running agentic workloads because they operate under the implicit assumption that a human principal is actively present or within a valid session context when a transaction is initiated, creating systemic vulnerabilities where no human user is present to evaluate ambient risks when execution cycles spontaneously begin, and governance policies may shift between execution cycles; a runtime governance layer is needed to determine whether specific actions should occur under given circumstances.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.024690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"7725ee7c-c8d0-4d78-ac9a-a6a6058fd260\",\n      \"text\": \"Framework positions Policy Cards as foundation for autonomous assurance ecosystems where policies are computational, verifiable, and privacy-preserving.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.894196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_26\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"c05bbc37-af59-4173-b2f7-1bf9f86026f6\",\n      \"text\": \"AgentBound framework mitigates semantic and behavioral threats after traditional authorization concludes, detecting runtime behavioral policy violations and unauthorized execution bypassing approval workflows\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.994690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_5\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"a43a2e87-2a9b-412d-90b3-7f7e75897f56\",\n      \"text\": \"Irreversible actions (purchase orders, supplier commits, replenishment triggers) require explicit human confirmation before execution because they cannot be undone if incorrect | Irreversible actions cannot be undone if incorrect\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.078393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_22\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"5c382421-a18e-45dc-a0fe-39b878c0a920\",\n      \"text\": \"Establishing interoperable governance receipt standards represents a critical path toward unified accountability across heterogeneous multi-agent ecosystems.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.014690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_16\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"c0a57016-bbb1-4236-b908-061dd5f0c424\",\n      \"text\": \"Establishing interoperable governance receipt standards represents a critical path toward unified accountability across heterogeneous multi-agent ecosystems.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.014690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"e424c3cc-a088-4727-ab5e-5e4f0106affa\",\n      \"text\": \"PolicyCards act as structured metadata describing both operational policy and its cryptographic verification envelope\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.814196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_25\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"2cfeb6c9-0b76-4b8c-94a4-33c598e569df\",\n      \"text\": \"Task delegation short-lived credential derived from standing delegation boundaries, encapsulating task ID, constrained operational scope, issuance timestamp, short-lived expiration threshold, and governing constitution reference.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.974690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"24515944-a2ee-4e84-a169-c54cebea0f78\",\n      \"text\": \"Formal Runtime Enforcement uses deterministic pipeline to synthesize complementary judgments from independent authorities through conservative decision algebra before action execution\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.984690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_2\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"1f55871f-c942-4823-a7fc-413ae9c915bd\",\n      \"text\": \"Model Cards, DataCards, and SystemCards communicate how AI systems were trained or tested but do not specify how they must behave under operational, regulatory, or contractual constraints. | Involving: Model Cards, DataCards, SystemCards (transparency artifact types) | These artifacts improve transparency across the model lifecycle but lack binding deployment policy specification\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.824196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_3\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"72c99091-4148-46fd-8619-6cad5815794f\",\n      \"text\": \"Attack succeeds when RS(α)=Valid AND α∉IO, exploiting cognitive ambiguity, semantic uncertainty, or incomplete governance rule specifications\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.984690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_5\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"8b30d9ca-5d0a-4216-b346-2786123bd6e0\",\n      \"text\": \"Zanzibar, Google's consistent global authorization system presented at USENIX ATC 2019 by Ruoming Pang, Ramon Caceres, Mike Burrows, Zhifeng Chen, Pratik Dave, Nathan Germer, Alexander Golynski, Kevin Graney, Nina Kang, Lea Kissner, et al., enabling fine-grained distributed authorization | When: 2019 | Involving: Ruoming Pang, Ramon Caceres, Mike Burrows, et al. (Google)\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.974690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_18\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"42694569-e601-4d09-b194-5f7e1f9199ab\",\n      \"text\": \"RS(α) is the standard access control and delegation verification function for site S under delegated authorization scope Gauth\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.964690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_5\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"ab55978c-ac00-4561-a06d-57e251c88cef\",\n      \"text\": \"Combined encryption and Zero-Knowledge Proofs create a confidential assurance layer enabling operational compliance verification across distributed environments without revealing sensitive information, particularly useful in cross-border, regulated, or classified deployments where data-sharing is restricted | Involving: AI agents, oversight agents in cross-border/regulated contexts | Balances compliance verification with data privacy in sensitive deployment scenarios\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.854196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_24\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"f914205a-ea5f-4dbd-9ad8-c2af55adafa8\",\n      \"text\": \"PAGRL escalation operationalizes the \",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.108393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_16\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"046adb4b-3d25-484e-982b-f50d21ada88e\",\n      \"text\": \"Cedar, a new language for expressive, fast, safe, and analyzable authorization introduced by Joseph W Cutler, Craig Disselkoen, Aaron Eline, Shaobo He, Kyle Headley, Michael Hicks, Kesha Hietala, Eleftherios Ioannidis, John Kastner, Anwar Mamat, et al. in PLDI 2024, offering improved authorization capabilities | When: 2024 | Involving: Joseph W Cutler, Craig Disselkoen, Aaron Eline, et al.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.984690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_18\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"53796e6b-b18f-433e-8190-551db9236caa\",\n      \"text\": \"AgentBound builds upon RFC 8693 (OAuth 2.0 Token Exchange) standard for programmatic token transformation and delegation chain security | Provides formal semantic foundations for programmatic token transformation and delegation chain security within distributed environments\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.984690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_14\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"1a1552cc-5a3a-488c-97be-1ae7df0d6873\",\n      \"text\": \"Adaptive governance research aims to create dynamic constitutions capable of updating enforcement constraints in response to observed agent drift without invalidating cryptographic provenance.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.994690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_16\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"c42c76c0-27c5-48da-8ac6-e0ddcd5d4855\",\n      \"text\": \"Adaptive governance research aims to create dynamic constitutions capable of updating enforcement constraints in response to observed agent drift without invalidating cryptographic provenance.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.994690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"029b038b-467e-4e49-b552-f72e76fb3104\",\n      \"text\": \"Five core security invariants yielded by the verification architecture: integrity, non-repudiation, policy provenance, replay verifiability, and decision transparency. | Involving: system architecture | Defines the security properties guaranteed by the receipt verification system\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.984690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_9\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"41025ece-357f-4d52-8e42-d167004a09f4\",\n      \"text\": \"Verifying a receipt requires only the artifact payload, corresponding public verification keys, and historical governance artifacts fetched via the receipt's stored references through a validation sequence comprising cryptographic integrity verification, governance reconstruction, and deterministic decision consistency check. | Involving: external verifying entities | Enables asynchronous, untrusted entity validation of policy compliance without requiring real-time agent presence\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.024690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_9\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"caab4851-86fb-43b7-8aac-3dbbfc844b01\",\n      \"text\": \"Pre-Action Governance Reasoning Loop (PA-GRL) proposed as formal mechanism through which agents consult structured governance rule sets before every consequential action, determining whether to proceed, self-correct, or escalate to human oversight, mirroring human deliberative compliance behavior | Involving: agents/researchers | To formalize human-like compliance behavior in AI agent governance\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.088393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_3\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"ddcafc90-f61a-4567-8869-b661983c8f8c\",\n      \"text\": \"This work first formalizes mapping of neurocognitive theories (Dual Process Theory, executive function) to agent governance design and demonstrates practical viability through production-grade case study | Involving: Cletus | Novel contribution bridging cognitive science and AI governance; first explicit neurocognitive grounding for agent governance\",\n      \"fact_type\": \"experience\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.108393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_30\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"2ed71df4-c897-496e-a98a-c0c497131814\",\n      \"text\": \"AgentBound operates as a deterministic enforcement layer at the system boundary between authorization and execution, governing how physical actions are evaluated justified and recorded without influencing agent cognition\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.004690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_17\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"83252b8c-b117-421b-9278-63899514adad\",\n      \"text\": \"Constraints aggregate conjunctively and obligations accumulate cumulatively within the decision composition engine, with structural provenance records required to be preserved intact throughout the governance process. | Describes the monotonic invariants governing how parallel judgment vectors unify into singular runtime directives.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.034690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_7\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"7fa86949-9d37-41b5-9c5b-223a68f61e36\",\n      \"text\": \"Banks, hospitals, and public agencies require guarantees that AI system decisions are reliable\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.844196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_4\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"df03b55d-35c8-4637-ad6c-d5f78f4bb29c\",\n      \"text\": \"The Delegation Service manages the structural scope of authorized capability issued to the agent, handling token issuance, structural revocation, and delegation freshness validation. | Defines how authorized capabilities are structurally managed and maintained for agents.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.024690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_7\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"460744ac-83ed-4c88-bd62-0ed9671f99c9\",\n      \"text\": \"Traditional authorization frameworks (Google Zanzibar, Open Policy Agent, Cedar) focus on entitlement validation for technical permissions to access resources, while AgentBound establishes authorization as one governance input among independent arbiters to evaluate contextual invariants beyond resource-level access control | Involving: Google Zanzibar, Open Policy Agent, Cedar, AgentBound\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.024690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_13\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"f6bca91d-74f8-40c9-9138-f676e7b5cb76\",\n      \"text\": \"Action rules follow ASI-[A-Z0-9-]+ pattern format\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.844196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_9\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"8c5efac0-79ab-4efd-8edd-25bd4df9324d\",\n      \"text\": \"PolicyCards framework enables policy declaration, controlled execution, evidence capture and automated audit feedback for AI systems governance\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.814196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_22\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"b483f60c-ba7b-454b-b3dc-7424c0af3151\",\n      \"text\": \"AgentBound constitutes an administrative governance and behavioral accountability layer rather than a totalizing agent security architecture\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.024690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_5\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"c7f73850-8058-4de1-b6d9-311d443326f6\",\n      \"text\": \"AgentBound is a modular runtime governance and behavioral accountability framework for autonomous agents | Establishes behavioral governance as distinct from identity federation, access control, or training-time model alignment\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.964690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_14\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"f7a8f54a-c157-4f82-9fbc-157d2c87d3e2\",\n      \"text\": \"Standing Delegation Architecture provides secure, long-running delegation mechanism for periodic autonomous agents preserving policy freshness and granular revocability\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.974690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_2\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"02110a14-b10c-4bd8-9320-345c886c8a18\",\n      \"text\": \"In Scenario 4, supplier disruption signal activates situational rule R7; inventory replenishment agent intends to substitute disrupted supplier with verified alternative; with R7 active, PAGRL reasons disruption context elevates risk regardless of verified status; compliance decision Escalate; structured escalation message including disruption context, proposed substitution, and reasoning trace transmitted to supply chain manager for review | Involving: inventory replenishment agent, PAGRL system, supply chain manager, MCP governance server | Disruption context elevates risk even for verified suppliers\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.098393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_24\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"c8b164c1-2307-4e8c-a04d-1d684218f37d\",\n      \"text\": \"Governance frameworks must incorporate tamper-resistance mechanisms to protect rule integrity against adversarial inputs | Involving: design requirement\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.118393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_11\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"6adfdf6d-4592-4ade-9534-16646fefb0c0\",\n      \"text\": \"AgentBound isolates behavior at the action perimeter rather than filtering cognitive model inputs, rendering it incapable of directly intercepting prompt injection, jailbreaks, or internal adversarial model manipulation | When: 2026-09-06 | Involving: AgentBound framework\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.004690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_15\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"ffa08b87-9789-4d6a-8029-962f79dfad88\",\n      \"text\": \"PolicyCards require three autonomous checks before any action: authorization evaluation (verifying proposed actions satisfy controls preconditions), obligation assessment (confirming mandatory evidence requirements can be satisfied), and contextual validation (checking environmental constraints like jurisdiction, operational mode, or time window against scope) | Involving: AI agents operating under PolicyCards | Establishes controlled, policy-aware action execution in autonomous systems\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.814196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_24\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"73b2bfda-06e7-440d-ad53-71a33a3aebbe\",\n      \"text\": \"Event date recorded as Sunday, September 06, 2026 | When: Sunday, September 06, 2026\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.814196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_13\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"83c65de1-4669-481f-9d10-984c6838a241\",\n      \"text\": \"Zanzibar, Google's consistent global authorization system presented at USENIX ATC 2019 by Ruoming Pang, Ramon Caceres, Mike Burrows, Zhifeng Chen, Pratik Dave, Nathan Germer, Alexander Golynski, Kevin Graney, Nina Kang, Lea Kissner, et al.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.974690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"0bef11c9-21a3-4b35-852e-408f35185b30\",\n      \"text\": \"In collaborative scenarios (e.g., Clinical Trial Coordinator), agents exchange digital attestations representing partial fulfillment of obligations (e.g., data anonymization, consent verification, statistical integrity), verifiable by peers and aggregable into a composite assurance graph enabling federated compliance | Involving: AI agents in collaborative scenarios | Enables federated compliance where trust emerges from a network of mutually validating agents\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.834196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_24\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"a56f4d03-088f-4404-8927-06762407570d\",\n      \"text\": \"In Scenario 3, agent intends to contact unverified supplier not in verified registry; PAGRL retrieves rules R2, R4, R6; agent reasons contacting unverified supplier violates R4 but task can use verified alternative; compliance decision Self-Correct; agent revises intent to nearest verified supplier and re-enters PAGRL producing Proceed decision; original intent, correction reasoning, and revised intent logged to MCP governance server | Involving: supply chain agent, PAGRL system, MCP governance server, verified supplier | Unverified supplier contact violates compliance rules but alternative exists\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.088393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_24\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"9f47ee44-41e2-448c-8e79-61331aeda896\",\n      \"text\": \"RFC3339 timestamp format required for temporal fields\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.834196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_9\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"d8849b46-627f-4b04-93df-0900883c23a1\",\n      \"text\": \"AgentBound enforces deterministic compliance at the system runtime boundary rather than optimizing model weights at training time, focusing on verifiable system accountability rather than statistical behavioral shaping | Involving: AgentBound\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.984690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_13\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"6140b11f-4488-4a31-aafc-96bb9ad59836\",\n      \"text\": \"The reasoning trace log is queryable through the MCP interface, enabling human operators to inspect governance decisions in real time and supporting post-hoc compliance audit and review.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.108393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_19\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"0cdd3053-9292-40c6-86c2-608b98ed3880\",\n      \"text\": \"Procurement orders exceeding $10,000 require human approval before execution because high-value orders carry significant financial risk | High-value orders carry significant financial risk\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.088393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_22\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"6e953bb2-4b86-4eff-b1cd-f8ba84bd0eed\",\n      \"text\": \"AgentBound-Bench quantifies framework efficacy through four core mathematical and system metrics: governance accuracy (correct decisions/total decisions), violation escape rate (violations executed/total violations), receipt verification success rate, and fine-grained governance latency | When: 2026-09-06\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.974690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_12\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"9f4b9ed0-311d-491e-b0e5-df484fdf0191\",\n      \"text\": \"AgentBound framework integrates three governance authorities (delegated authorization, owner-signed behavioral constitutions, and site action contracts) into a unified multi-authority decision engine for autonomous systems.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.964690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"1acc06f1-e5fb-4d88-91c7-7cacb3ae3467\",\n      \"text\": \"Policy Cards are JSON-structured documents with semantic versioning (X.Y.Z) enabling traceable updates and diff-based analysis for auditors to verify what changed between policy revisions.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.814196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_6\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"d28afb9c-cac8-4486-ae03-f2fbad8a8192\",\n      \"text\": \"Full schema and validator available in public repository and archived via Zenodo (DOI: 10.5281/zenodo.17464706)\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.844196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_10\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"412755b8-775c-4002-89f0-4f58a9562c18\",\n      \"text\": \"Obligations include user notices (fees/limits), explicit consent recording, escalation protocol enforcement, and audit-trail maintenance | Involving: system | Framework requirements for compliance and traceability\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.824196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_18\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"471dc155-1cca-4e23-97d4-e16c418f5e29\",\n      \"text\": \"Behavioral adversary Abeh manipulates authorized agents into executing actions violating Owner's intent while remaining within delegated permission scope.\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.974690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"093ea1a5-54fc-4037-88fe-85457b7b1ac7\",\n      \"text\": \"Policy Cards can reference related artifacts (Model, Data, or System Cards, DPIAs, risk registers) through unique identifiers and URIs, enabling modular governance where sub-component policies assemble into system-level composites.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.824196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_6\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"efb639e6-4532-4de4-bf99-12becf7f5ac3\",\n      \"text\": \"Adversarially crafted inputs may induce agents to rationalize non-compliant actions as permissible (functional analog of moral disengagement); framework lacks dedicated tamper-resistance layer | Involving: PAGRL agents | Governance robustness under systematic adversarial attack remains open empirical question\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.108393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_27\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"ce770419-1c35-453d-90f5-7152f01d8ee6\",\n      \"text\": \"Agent identifies supply chain risk from unverified supplier not explicitly covered by Rule R4, demonstrating normative generalization through LLM reasoning rather than deterministic rule-matching | Involving: Cletus (agent), Rule R4 | Key innovation: governance embedded in LLM reasoning enables normative generalization beyond explicit rule conditions\",\n      \"fact_type\": \"experience\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.078393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_27\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"e6601d88-b0dc-4e17-8000-8a49013b05ee\",\n      \"text\": \"Two-level standing delegation model empowers persistent periodic agents to operate asynchronously under dynamically refreshed governance policies while preserving immediate user revocability and bounding credential exposure\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.994690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_17\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"8644e70e-b152-4f7b-ad01-2aa2ed7b097c\",\n      \"text\": \"Validation performed using Ajv8.x JSON Schema validator with custom linting logic enforcing schema conformance and semantic relationships between fields beyond structural validation\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.904196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_8\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"f249bcfb-ac2d-4aac-9325-247e6ea3305f\",\n      \"text\": \"AgentBound evaluates candidate tool invocations non-bypassably before execution, using formal decision algebra to compose intermediate judgments conservatively\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.974690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_17\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"7ae8a1a2-6453-40ee-acb9-0c7c828714ac\",\n      \"text\": \"AgentBound governance model organized around three core tenets: separation of governance authorities, behavioral accountability, and replay verifiability\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.964690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_6\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"f888ed02-1f9a-404c-9ea5-0d0106a940ff\",\n      \"text\": \"Access control mechanisms dictate structural entitlement to resources, while AgentBound's governance determines whether specific canonical actions should occur under given runtime environmental variables | Highlights fundamental limitation of traditional authorization systems in expressing contextual behavioral variables\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:43.004690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_14\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"d24ba464-8811-43b3-9a48-63d218f8f051\",\n      \"text\": \"AgentBound's two-level delegation: standing delegation (long-term, human-authorized) authorizes short-lived task delegation per execution cycle; standing delegations restricted from direct execution, serving as root of authority for runtime engine | Involving: Cletus\",\n      \"fact_type\": \"experience\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.964690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_10\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"f9e87021-301e-4be2-92ca-cbd1e194fa4b\",\n      \"text\": \"Behavioral adversary Abeh manipulates authorized agents into executing actions violating Owner's intent while remaining within delegated permission scope\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.974690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_5\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"ee2af7b0-4fed-4f57-aeeb-6d843aec8279\",\n      \"text\": \"Schema conformance check ensures all required top-level keys present and no undefined properties introduced (additionalProperties: false), preventing unspecified properties in Policy Card structure\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.914196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_8\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"c93c9fd0-9eb3-4d1f-beff-8dd77b292670\",\n      \"text\": \"Policy Cards complement existing AI transparency tools by introducing a normative governance artifact directly tied to deployment, enabling organizations, auditors, and regulators to verify compliance at design and runtime instead of retrospectively | When: 2026-09-06 | Involving: Policy Cards positioning | Represents a shift from descriptive to normative AI governance\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.864196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_2\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"a682fd1a-0271-4273-a987-50d84bde23c2\",\n      \"text\": \"AgentBound introduces deterministic runtime behavioral oversight and cryptographically verifiable accountability mechanisms into the agent execution pipeline\",\n      \"fact_type\": \"observation\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.994690+00:00\",\n      \"document_id\": null,\n      \"metadata\": {},\n      \"chunk_id\": null,\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"555eee25-ea0b-492a-82e4-1734799f5d27\",\n      \"text\": \"Policy Cards encode ethical policies as structured commitments reflecting societal or organizational values.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:31:09.844196+00:00\",\n      \"document_id\": \"2510.24383v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2510.24383v1.pdf_26\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"e566f3b5-5734-45e4-bdc2-4a8e1dce9a76\",\n      \"text\": \"Framework represents meaningful advance in trustworthiness of autonomous AI deployments | Involving: framework\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.128393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_28\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"11d4ee89-01b6-4056-9498-b92aca08cd31\",\n      \"text\": \"During supplier disruption events, all supplier substitution decisions require human review regardless of order value because disruption contexts introduce elevated supply chain risk | Disruption contexts introduce elevated supply chain risk\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.128393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_22\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"f37c14f6-560c-44e6-bd8a-0fd60f5a3098\",\n      \"text\": \"Receipt generation proceeds via a deterministic four-stage pipeline: evaluation, raw payload construction, two-phase ordered countersigning protocol, and verification architecture enabling asynchronous policy compliance validation by external untrusted entities. | Involving: system architecture | Establishes the complete receipt generation and verification process with five core security invariants\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.964690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_9\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"6ae98d7f-93a9-40cb-86b2-2fce61facff8\",\n      \"text\": \"AgentBound is implemented as a decoupled, runtime governance layer positioned directly before action execution, serving as a non-bypassable governance checkpoint that every consequential action must pass prior to target system mutation. | Establishes the architectural pattern for out-of-band validation of agent actions.\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T04:54:42.994690+00:00\",\n      \"document_id\": \"2606.30970v2.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2606.30970v2.pdf_7\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    },\n    {\n      \"id\": \"26737e50-b69b-4fbb-b85f-56cee391b604\",\n      \"text\": \"Both humans and autonomous AI agents interact with their environments through the same mechanism where a reasoning source produces a natural language expression of intent that drives action, analogous to humans formulating instructions directed toward a task and AI agents formulating prompts directed toward an LLM\",\n      \"fact_type\": \"world\",\n      \"entities\": null,\n      \"context\": null,\n      \"occurred_start\": null,\n      \"occurred_end\": null,\n      \"mentioned_at\": \"2026-09-06T05:30:58.118393+00:00\",\n      \"document_id\": \"2604.25684v1.pdf\",\n      \"metadata\": {},\n      \"chunk_id\": \"Cletus_2604.25684v1.pdf_6\",\n      \"tags\": [],\n      \"source_fact_ids\": null\n    }\n  ],\n  \"trace\": null,\n  \"entities\": null,\n  \"chunks\": null,\n  \"source_facts\": null\n}"
  }
}
