_id\n    return jsonify({'short_url': short_url})\n\n@app.route('/payment-info')\ndef payment_info():\n    \"\"\"Endpoint to get payment details for debugging\"\"\"\n    challenge, nonce = generate_payment_challenge()\n    return jsonify({\n        'amount': AMOUNT_USDC,\n        'asset': ASSET,\n        'dest': DEST_ADDRESS,\n        'network': NETWORK,\n        'challenge': challenge,\n        'nonce': nonce\n    })\n\n@app.route('/<short_id>')\ndef redirect_to_long(short_id):\n    long_url = url_map.get(short_id)\n    if long_url:\n        return redirect(long_url)\n    return jsonify({'error': 'URL not found'}), 404\n\nif __name__ == '__main__':\n    port = int(os.environ.get('PORT', 18080))\n    app.run(host='0.0.0.0', port=port, debug=False)"})
