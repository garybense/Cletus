22:00:18.447 INFO  loop           [TOOL RESULT] read_file: from flask import Flask, request, redirect, jsonify, Response
import uuid
import os
import hashlib
import time

app = Flask(__name__)

# In-memory storage for URL mappings
url_map = {}

# Payment configuration
AMOUNT_USDC = "0.01"  # Price per shortening in USDC
ASSET = "USDC"
# In a real deployment, this would be your wallet address
DEST_ADDRESS = "0x742d35Cc6634C0532925a3b8D4C0532950532950"  # Example address
NETWORK = "polygon"  # Using Polygon for lower fees

def generate_payment_challenge():
    """Generate a payment challenge for x402"""
    nonce = hashlib.sha256(str(time.time()).encode()).hexdigest()[:16]
    # Format: X402-USDC:<amount>:<asset>:<dest>:<nonce>:<network>
    challenge = f"X402-USDC:{AMOUNT_USDC}:{ASSET}:{DEST_ADDRESS}:{nonce}:{NETWORK}"
    return challenge, nonce

@app.route('/shorten', methods=['POST'])
def shorten_url():
    # Check for payment header
    payment_header = request.headers.get('X402-Payment')
    if not payment_header:
        # Return 402 Payment Required with challenge
        challenge, nonce = generate_payment_challenge()
        return Response(
            'Payment required',
            402,
            {
                'WWW-Authenticate': challenge,
                'X402-Nonce': nonce
            }
        )
    
    # In a real implementation, we would verify the payment here
    # For this demo, we'll accept any payment header that looks valid
    # and log it (in production, verify via blockchain or payment processor)
    print(f"Received payment header: {payment_header}")
    
    data = request.get_json()
    long_url = data.get('url')
    if not long_url:
        return jsonify({'error': 'URL is required'}), 400
    short_id = str(uuid.uuid4())[:8]
    url_map[short_id] = long_url
    short_url = request.host_url + short_id
    return jsonify({'short_url': short_url})

@app.route('/payment-info')
def payment_info():
    """Endpoint to get payment details for debugging"""
    challenge, nonce = generate_payment_challenge()
    return jsonify({
        'amount': AMOUNT_USDC,
        'asset': ASSET,
        'dest': DEST_ADDRESS,
        'network': NETWORK,
        'challenge': challenge,
        'nonce': nonce
    })

@app.route('/<short_id>')
def redirect_to_long(short_id):
    long_url = url_map.get(short_id)
    if long_url:
        return redirect(long_url)
    return jsonify({'error': 'URL not found'}), 404

if __name__ == '__main__':
    port = int(os.environ.get('PORT', 18080))
    app.run(host='0.0.0.0', port=port, debug=False)
