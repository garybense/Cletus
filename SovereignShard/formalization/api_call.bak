#!/usr/bin/env python3
import requests, json, sys
base_url = sys.argv[1]
model = sys.argv[2]
temp = float(sys.argv[3])
key = sys.argv[4]
role = sys.argv[5]
content = '\n'.join(sys.argv[6:])

resp = requests.post(
    f"{base_url}/chat/completions",
    headers={"Content-Type": "application/json", "Authorization": f"Bearer {key}"},
    json={"model": model, "messages": [{"role": role, "content": content}], "temperature": temp, "max_tokens": 4096},
    timeout=120
)
resp.raise_for_status()
print(json.loads(resp.text)["choices"][0]["message"]["content"])
